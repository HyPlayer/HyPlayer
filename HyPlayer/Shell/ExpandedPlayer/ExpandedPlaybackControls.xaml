<UserControl
    x:Class="HyPlayer.Shell.ExpandedPlayer.ExpandedPlaybackControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:HyPlayer.UI.Controls.Primitives"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A808080" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#26808080" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <Style x:Key="TransportButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="RootGrid"
        DoubleTapped="RootGrid_DoubleTapped"
        Tapped="RootGrid_Tapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <primitives:FluidBar
            x:Name="ProgressBar"
            Grid.Row="0"
            BarBrush="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}" />
        <Grid Grid.Row="1" Margin="0,-2,0,0">
            <TextBlock
                x:Name="ElapsedText"
                HorizontalAlignment="Left"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                Opacity="0.6"
                Text="0:00" />
            <TextBlock
                x:Name="RemainingText"
                HorizontalAlignment="Right"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                Opacity="0.6"
                Text="-0:00" />
            <Grid x:Name="QualityHost" HorizontalAlignment="Center">
                <TextBlock
                    x:Name="QualityText"
                    CharacterSpacing="60"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Text="" />
                <Grid
                    x:Name="QualityRevealHost"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Grid x:Name="QualityMaskSource">
                        <TextBlock
                            x:Name="QualityRevealText"
                            CharacterSpacing="60"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="过渡" />
                    </Grid>
                    <Border x:Name="QualityBloomHost" />
                    <Border x:Name="QualityFillHost" />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,6,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BtnPlayMode"
                Grid.Column="0"
                Width="36"
                Height="36"
                HorizontalAlignment="Left"
                AutomationProperties.Name="播放顺序"
                Click="BtnPlayMode_Click"
                CornerRadius="18"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="顺序播放">
                <FontIcon
                    x:Name="IconPlayMode"
                    FontSize="16"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Glyph="&#xE169;" />
            </Button>
            <Button
                x:Name="BtnPrevious"
                Grid.Column="1"
                Width="56"
                Height="56"
                AutomationProperties.Name="上一首"
                Click="BtnPrevious_Click"
                CornerRadius="28"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="上一首">
                <FontIcon
                    x:Name="IconPrevious"
                    FontSize="26"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Glyph="&#xF8AC;" />
            </Button>
            <Button
                x:Name="BtnPlayPause"
                Grid.Column="2"
                Width="72"
                Height="72"
                Margin="20,0"
                AutomationProperties.Name="播放/暂停"
                Click="BtnPlayPause_Click"
                CornerRadius="36"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="播放/暂停">
                <FontIcon
                    x:Name="IconPlayPause"
                    FontSize="38"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Glyph="&#xF5B0;" />
            </Button>
            <Button
                x:Name="BtnNext"
                Grid.Column="3"
                Width="56"
                Height="56"
                AutomationProperties.Name="下一首"
                Click="BtnNext_Click"
                CornerRadius="28"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="下一首">
                <FontIcon
                    x:Name="IconNext"
                    FontSize="26"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Glyph="&#xF8AD;" />
            </Button>
            <Button
                x:Name="BtnMore"
                Grid.Column="4"
                Width="36"
                Height="36"
                HorizontalAlignment="Right"
                AutomationProperties.Name="更多"
                CornerRadius="18"
                Style="{StaticResource TransportButtonStyle}"
                ToolTipService.ToolTip="更多">
                <FontIcon
                    FontSize="16"
                    Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                    Glyph="&#xE712;" />
                <Button.Flyout>
                    <MenuFlyout
                        x:Name="MoreFlyout"
                        Opening="MoreFlyout_Opening"
                        Placement="Top">
                        <MenuFlyoutItem
                            x:Name="ItemLike"
                            Click="ItemLike_Click"
                            Text="喜欢">
                            <MenuFlyoutItem.Icon>
                                <FontIcon x:Name="ItemLikeIcon" Glyph="&#xE006;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="ItemPlaylist_Click" Text="播放列表">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE142;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="ItemDesktopLyrics"
                            Click="ItemDesktopLyrics_Click"
                            Text="桌面歌词">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Click="ItemListenTogether_Click" Text="一起听">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE716;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="ItemSubscribe"
                            Click="ItemSubscribe_Click"
                            Text="收藏到歌单">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE1DA;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="ItemDownload"
                            Click="ItemDownload_Click"
                            Text="下载">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE118;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="ItemComment"
                            Click="ItemComment_Click"
                            Text="评论">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8F2;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="ItemShare"
                            Click="ItemShare_Click"
                            Text="分享">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72D;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>
        <Grid Grid.Row="3" Opacity="0.75">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon
                Grid.Column="0"
                Margin="0,0,10,0"
                FontSize="14"
                Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                Glyph="&#xE993;" />
            <primitives:FluidBar
                x:Name="VolumeBar"
                Grid.Column="1"
                BarBrush="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}" />
            <FontIcon
                Grid.Column="2"
                Margin="10,0,0,0"
                FontSize="14"
                Foreground="{x:Bind ViewModel.PlaybackAccentBrush, Mode=OneWay}"
                Glyph="&#xE995;" />
        </Grid>
    </Grid>
</UserControl>
