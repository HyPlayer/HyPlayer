<UserControl
    x:Class="HyPlayer.Shell.Account.ShellAccountMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Button
        x:Name="AccountAvatarButton"
        Width="36"
        Height="36"
        Padding="0"
        AutomationProperties.Name="{x:Bind _navigationShell.AccountName, Mode=OneWay}"
        Background="Transparent"
        BorderThickness="0"
        ToolTipService.ToolTip="{x:Bind _navigationShell.AccountName, Mode=OneWay}">
        <Button.Flyout>
            <MenuFlyout Placement="Bottom">
                <MenuFlyoutItem
                    x:Name="AccountSummaryItem"
                    IsEnabled="False"
                    Text="{x:Bind _navigationShell.AccountName, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    IsEnabled="False"
                    Text="{x:Bind _navigationShell.AccountSubtitle, Mode=OneWay}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="AccountProfileMenuItem"
                    Click="OpenProfile_Click"
                    Text="{x:Bind _navigationShell.AccountProfileButtonText, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Contact" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    Click="Relogin_Click"
                    Text="重新登录"
                    Visibility="{x:Bind _navigationShell.IsAutoLoginUnreachable, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="OtherUser" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Click="OpenSettings_Click" Text="设置">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator Visibility="{x:Bind _navigationShell.AccountSignOutVisibility, Mode=OneWay}" />
                <MenuFlyoutItem
                    x:Name="AccountSignOutMenuItem"
                    Click="SignOut_Click"
                    Text="退出登录"
                    Visibility="{x:Bind _navigationShell.AccountSignOutVisibility, Mode=OneWay}">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Back" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.Flyout>
        <Grid>
            <PersonPicture
                Width="28"
                Height="28"
                Initials="{x:Bind _navigationShell.AccountInitials, Mode=OneWay}"
                ProfilePicture="{x:Bind _navigationShell.AccountAvatarSource, Mode=OneWay}" />
            <muxc:ProgressRing
                Width="34"
                Height="34"
                IsActive="{x:Bind _navigationShell.IsAutoLoginPending, Mode=OneWay}"
                IsHitTestVisible="False"
                Visibility="{x:Bind _navigationShell.IsAutoLoginPending, Mode=OneWay}" />
            <Ellipse
                Width="9"
                Height="9"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{ThemeResource SystemControlErrorTextForegroundBrush}"
                IsHitTestVisible="False"
                Visibility="{x:Bind _navigationShell.IsAutoLoginUnreachable, Mode=OneWay}" />
        </Grid>
    </Button>
</UserControl>