<Page
    x:Class="HyPlayer.Pages.BasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:classes="using:HyPlayer.Classes"
    xmlns:controls1="using:HyPlayer.Controls"
    xmlns:converters="using:HyPlayer.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:frieren="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:frierenUI="using:Microsoft.Toolkit.Uwp.UI"
    xmlns:local="using:HyPlayer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:uiExtensions="using:CommunityToolkit.WinUI.Helpers"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light" />
                        <ResourceDictionary x:Key="Dark" />
                        <ResourceDictionary x:Key="HighContrast" />
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="NavigationNodeHeaderTemplate" x:DataType="classes:NavigationNode">
                <muxc:NavigationViewItemHeader Content="{x:Bind Title}" />
            </DataTemplate>

            <DataTemplate x:Key="NavigationNodeSeparatorTemplate" x:DataType="classes:NavigationNode">
                <muxc:NavigationViewItemSeparator />
            </DataTemplate>

            <DataTemplate x:Key="NavigationNodeItemTemplate" x:DataType="classes:NavigationNode">
                <muxc:NavigationViewItem
                    Content="{x:Bind Title, Mode=OneWay}"
                    Icon="{x:Bind Icon, Mode=OneWay}"
                    SelectsOnInvoked="{x:Bind SelectsOnInvoked}"
                    Tag="{x:Bind}"
                    MenuItemsSource="{x:Bind Children}"
                    Visibility="{x:Bind IsVisible, Mode=OneWay}" />
            </DataTemplate>

            <converters:NavigationNodeTemplateSelector
                x:Key="NavigationNodeTemplateSelector"
                HeaderTemplate="{StaticResource NavigationNodeHeaderTemplate}"
                SeparatorTemplate="{StaticResource NavigationNodeSeparatorTemplate}"
                ItemTemplate="{StaticResource NavigationNodeItemTemplate}" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid x:Name="MainGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <FlyoutBase.AttachedFlyout>
                <MenuFlyout x:Name="PlaylistFlyout">
                    <MenuFlyoutItem
                        x:Name="ItemPublicPlayList"
                        Click="ItemPublicPlayList_Click"
                        Icon="People"
                        Text="公开此歌单" />
                    <MenuFlyoutItem
                        x:Name="ItemDelPlayList"
                        Click="ItemDelPlayList_Click"
                        Foreground="Red"
                        Icon="Delete"
                        Text="删除此歌单" />
                </MenuFlyout>
            </FlyoutBase.AttachedFlyout>
            <muxc:TeachingTip
                x:Name="TheTeachingTip"
                Title="一个弹窗, 两个弹窗, 三个弹窗, 四个弹窗...zzzzzz"
                CloseButtonClick="TheTeachingTip_OnCloseButtonClick"
                IsLightDismissEnabled="False"
                PreferredPlacement="TopRight" />
            <controls:TitleBar
                x:Name="AppTitleBar"
                Title="HyPlayer"
                Grid.Row="0"
                Height="48"
                Margin="0"
                VerticalAlignment="Top"
                x:FieldModifier="public"
                BackButtonClick="AppTitleBar_BackButtonClick"
                DisplayMode="Tall"
                IsBackButtonVisible="{x:Bind BaseFrame.CanGoBack, Mode=OneWay}"
                IsPaneButtonVisible="True"
                PaneButtonClick="AppTitleBar_PaneButtonClick"
                Subtitle="预览">
                <controls:TitleBar.Icon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/icon.png" />
                </controls:TitleBar.Icon>
                <controls:TitleBar.Content>
                    <AutoSuggestBox
                        x:Name="SearchAutoSuggestBox"
                        VerticalContentAlignment="Center"
                        LostFocus="SearchAutoSuggestBox_LostFocus"
                        PlaceholderText="搜索音乐、创作者与音乐视频"
                        QueryIcon="Find"
                        QuerySubmitted="AutoSuggestBox_QuerySubmitted"
                        SuggestionChosen="SearchAutoSuggestBox_OnSuggestionChosen"
                        TextChanged="SearchAutoSuggestBox_TextChanged" />
                </controls:TitleBar.Content>
            </controls:TitleBar>
            <muxc:NavigationView
                x:Name="NavMain"
                Grid.Row="1"
                x:FieldModifier="public"
                Canvas.ZIndex="0"
                FlowDirection="LeftToRight"
                IsBackButtonVisible="Collapsed"
                IsBackEnabled="True"
                IsSettingsVisible="False"
                IsTabStop="False"
                IsTitleBarAutoPaddingEnabled="False"
                ItemInvoked="NavMain_ItemInvoked"
                MenuItemTemplateSelector="{StaticResource NavigationNodeTemplateSelector}"
                MenuItemsSource="{x:Bind ViewModel.MenuItems}"
                PaneDisplayMode="Auto"
                SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                SelectionChanged="NavMain_OnSelectionChanged"
                Style="{StaticResource LeftNavViewDefaultStyle}">
                <muxc:NavigationView.PaneFooter>
                    <Grid Height="120" />
                </muxc:NavigationView.PaneFooter>
                <Grid>
                    <Frame
                        x:Name="BaseFrame"
                        Grid.Row="1"
                        Navigated="BaseFrame_Navigated" />
                </Grid>
            </muxc:NavigationView>


            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="641" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="BaseFrame.Margin" Value="0" />
                            <Setter Target="NavMain.IsPaneToggleButtonVisible" Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup>
                    <VisualState>
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1008" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="NavMain.IsPaneToggleButtonVisible" Value="False" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <!--  登录弹窗  -->
        <ContentDialog
            x:Name="DialogLogin"
            Title="登录"
            x:FieldModifier="Public"
            CloseButtonClick="ButtonCloseLoginForm_Click"
            CloseButtonText="取消"
            PrimaryButtonClick="ButtonLogin_OnClick"
            PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
            PrimaryButtonText="登录">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Pivot SelectionChanged="Pivot_SelectionChanged">
                        <PivotItem Header="密码登录">
                            <Grid>
                                <StackPanel Orientation="Vertical" Spacing="12">
                                    <TextBox
                                        x:Name="TextBoxAccount"
                                        KeyDown="TextBoxAccount_OnKeyDown"
                                        PlaceholderText="手机 / 邮箱" />
                                    <PasswordBox
                                        x:Name="TextBoxPassword"
                                        KeyDown="TextBoxPassword_OnKeyDown"
                                        PlaceholderText="密码" />
                                    <Grid>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                            Text="登录代表你同意相关条款" />
                                    </Grid>

                                </StackPanel>
                            </Grid>
                        </PivotItem>
                        <PivotItem Header="扫码登录" Tapped="LoadQr">
                            <Grid>
                                <Image
                                    x:Name="QrContainer"
                                    Height="160"
                                    HorizontalAlignment="Left"
                                    Tapped="LoadQr" />
                                <StackPanel
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Spacing="8">
                                    <Button Tapped="LoadQr">
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <FontIcon FontSize="14" Glyph="&#xE149;" />
                                            <TextBlock Text="刷新" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BtnScaleQrCode"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Content="查看大图">
                                        <Button.Flyout>
                                            <Flyout Placement="Left">
                                                <Image
                                                    x:Name="QrContainer2"
                                                    Height="320"
                                                    Margin="0,12,0,0"
                                                    HorizontalAlignment="Center"
                                                    Source="{x:Bind QrContainer.Source, Mode=OneWay}" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </PivotItem>
                    </Pivot>

                    <StackPanel
                        Grid.Row="2"
                        Width="400"
                        Margin="3,12,0,0"
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal">
                        <Button
                            x:Name="QQLogin"
                            Height="32"
                            Padding="2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ThirdPartyLogin_Click"
                            Tag="QQ"
                            ToolTipService.ToolTip="使用QQ登录">
                            <BitmapIcon Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" UriSource="/Assets/ThirdPartyIcons/QQ.png" />
                        </Button>
                        <Button
                            x:Name="WXLogin"
                            Height="32"
                            Padding="4"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ThirdPartyLogin_Click"
                            Tag="WX"
                            ToolTipService.ToolTip="使用微信登录">
                            <BitmapIcon Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" UriSource="/Assets/ThirdPartyIcons/WX.png" />
                        </Button>
                        <Button
                            x:Name="WBLogin"
                            Height="32"
                            Padding="5"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="ThirdPartyLogin_Click"
                            CornerRadius="5"
                            Tag="WB"
                            ToolTipService.ToolTip="使用微博登录">
                            <Button.Content>
                                <BitmapIcon Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" UriSource="/Assets/ThirdPartyIcons/SinaWB.png" />
                            </Button.Content>
                        </Button>

                    </StackPanel>
                    <HyperlinkButton
                        Grid.Row="2"
                        HorizontalAlignment="Right"
                        Content="无法登录?"
                        NavigateUri="https://blog.kengwang.com.cn/hyplayer-login-help" />
                    <muxc:InfoBar
                        x:Name="InfoBarLoginHint"
                        Title=""
                        Grid.Row="1"
                        IsClosable="True"
                        IsOpen="False" />
                </Grid>
            </Grid>

        </ContentDialog>
        <!--  登录提示弹窗  -->
        <ContentDialog
            x:Name="DialogPreLoginHint"
            x:FieldModifier="public"
            CloseButtonText="取消"
            PrimaryButtonClick="ButtonPreLoginPrimary_Click"
            PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
            PrimaryButtonText="继续登录">

            <StackPanel Orientation="Vertical">
                <TextBlock>由于网易云音乐登录风控加强, 现无法通过正常途径登录</TextBlock>
                <TextBlock>我们只能通过一些方法进行缓解, 但请注意由此带来的风险需由用户承担</TextBlock>
                <TextBlock>如果你继续代表你已经知晓风险</TextBlock>
                <TextBlock>我们提供以下手段缓解 (任选其一):</TextBlock>
                <controls:DockPanel LastChildFill="True">
                    <HyperlinkButton controls:DockPanel.Dock="Right" Click="BtnApiAddParamClick">查看教程</HyperlinkButton>
                    <TextBlock>抓取官方客户端登录信息 (稳定, 保存后重启)</TextBlock>
                </controls:DockPanel>
                <controls:DockPanel LastChildFill="True">
                    <HyperlinkButton controls:DockPanel.Dock="Right" Click="BtnCurrentDeviceIdClick">立即生成</HyperlinkButton>
                    <TextBlock>使用当前设备信息尝试伪造 (最新缓解)</TextBlock>
                </controls:DockPanel>
                <TextBlock>请在缓解后后使用扫码登录</TextBlock>
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
