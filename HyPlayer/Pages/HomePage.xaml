<?xml version="1.0" encoding="utf-8" ?>
<local:HomePageBase
    x:Class="HyPlayer.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:behaviors="using:HyPlayer.Behaviors"
    xmlns:card="using:HyPlayer.Controls.CardButton"
    xmlns:classes="using:HyPlayer.Classes"
    xmlns:communityBehaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:HyPlayer.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyplayer="using:HyPlayer"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:local="using:HyPlayer.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <local:HomePageBase.Resources>
        <muxc:StackLayout
            x:Key="CardListDefaultLayout"
            Orientation="Horizontal"
            Spacing="16" />
        <DataTemplate x:Key="RecommendedCardTemplate" x:DataType="classes:NCPlayList">
            <Button
                x:Name="Card"
                Width="256"
                Height="128"
                Margin="2,10"
                CornerRadius="8"
                RightTapped="{x:Bind hyplayer:Common.UIElement_RightTapped}"
                Click="Card_Click"
                CommandParameter="{x:Bind }"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind cover}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Column="1"
                        Margin="16,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind name}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{StaticResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind creater.name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind creater.name}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="ToplistCardTemplate" x:DataType="classes:NCPlayList">
            <Button
                x:Name="Card"
                Width="256"
                Height="128"
                Margin="2,10"
                CornerRadius="8"
                Click="Card_Click"
                CommandParameter="{x:Bind }"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind cover}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Column="1"
                        Margin="16,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind name}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{StaticResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind desc}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind desc}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="RecommendedSongCardTemplate" x:DataType="classes:NCSong">
            <Button
                x:Name="Card"
                Width="256"
                Height="352"
                Margin="2,10"
                HorizontalAlignment="Center"
                CornerRadius="8"
                Click="SongCard_Click"
                CommandParameter="{x:Bind }"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind CoverString}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Row="1"
                        Margin="0,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind songname}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind songname}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{StaticResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind ArtistString}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ArtistString}" />
                    </Grid>
                </Grid>
            </Button>
        </DataTemplate>
    </local:HomePageBase.Resources>

    <ScrollViewer>
        <Grid x:Name="ContentArea" Margin="0,0,0,96">
            <Grid x:Name="BackgroundLayer">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="350"
                        MinHeight="400"
                        MaxHeight="600" />
                    <RowDefinition Height="100" />
                </Grid.RowDefinitions>
                <controls:HomePageHeaderImage />
            </Grid>
            <Grid x:Name="ContentLayer" Margin="36,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="300" />
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header">
                    <TextBlock
                        x:Name="HeaderText"
                        Margin="0,36,0,40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="White"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        Text="主页" />
                </Grid>
                <Grid
                    x:Name="Toolbar"
                    Grid.Row="1"
                    HorizontalAlignment="Right">
                    <StackPanel
                        x:Name="ActionPanel"
                        Margin="0,40,20,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Canvas.ZIndex="1"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            Width="125"
                            Height="60"
                            Padding="16"
                            CornerRadius="6"
                            Command="{x:Bind ViewModel.HeartBeatModeClickedCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="22" Glyph="&#xE006;" />
                                <TextBlock
                                    x:Uid="HomePage_Btn_MyLike"
                                    FontSize="14"
                                    Text="心动模式" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="125"
                            Height="60"
                            Padding="16"
                            CornerRadius="6"
                            Command="{x:Bind ViewModel.LikedClickedCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="22" Glyph="&#xE163;" />
                                <TextBlock
                                    x:Uid="HomePage_Btn_DailyRcmd"
                                    FontSize="14"
                                    Text="每日推荐" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="125"
                            Height="60"
                            Padding="16"
                            CornerRadius="6"
                            Command="{x:Bind ViewModel.PersonalFmClickedCommand, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontSize="22" Glyph="&#xEFA9;" />
                                <TextBlock
                                    x:Uid="HomePage_Btn_PersonalFm"
                                    FontSize="14"
                                    Text="私人电台" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid
                    x:Name="Content"
                    Grid.Row="2"
                    Margin="12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="SignInedDataArea">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="305" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="8,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB50;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="官方歌单" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Visible"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <muxc:ItemsRepeater
                                        x:Name="CategryItemsRepeater"
                                        ItemTemplate="{StaticResource ToplistCardTemplate}"
                                        ItemsSource="{x:Bind ViewModel.OfficialPlaylists, Mode=OneWay}"
                                        Layout="{StaticResource CardListDefaultLayout}" />
                                </ScrollViewer>
                            </Grid>
                            <Grid Grid.Row="1" Margin="8,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="推荐歌单" />
                                </StackPanel>
                                <ScrollViewer
                                    Grid.Row="1"
                                    HorizontalScrollBarVisibility="Visible"
                                    HorizontalScrollMode="Enabled"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled">
                                    <muxc:ItemsRepeater
                                        x:Name="RecommendedItemsRepeater"
                                        ItemTemplate="{StaticResource RecommendedCardTemplate}"
                                        ItemsSource="{x:Bind ViewModel.RecommendedPlaylist, Mode=OneWay}"
                                        Layout="{StaticResource CardListDefaultLayout}" />

                                </ScrollViewer>
                            </Grid>
                        </Grid>

                        <Grid
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC4F;" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="推荐单曲" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <FlipView
                                    x:Name="RecommendedSongsFlipView"
                                    Height="380"
                                    Background="Transparent"
                                    ItemTemplate="{StaticResource RecommendedSongCardTemplate}"
                                    ItemsSource="{x:Bind ViewModel.RecommendedSongs, Mode=OneWay}" />
                                <muxc:PipsPager
                                    HorizontalAlignment="Center"
                                    NumberOfPages="{x:Bind ViewModel.RecommendedSongs.Count, Mode=OneWay}"
                                    SelectedPageIndex="{x:Bind RecommendedSongsFlipView.SelectedIndex, Mode=OneWay}" />

                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="8,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE734;" />
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{ThemeResource SubtitleTextBlockStyle}"
                                Text="排行榜" />
                        </StackPanel>
                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Visible"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled"
                            ZoomMode="Disabled">
                            <muxc:ItemsRepeater
                                x:Name="ToplistItemsRepeater"
                                ItemTemplate="{StaticResource ToplistCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.ToplistPlaylist, Mode=OneWay}"
                                Layout="{StaticResource CardListDefaultLayout}" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</local:HomePageBase>
