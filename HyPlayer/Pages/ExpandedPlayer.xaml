<Page
    x:Class="HyPlayer.Pages.ExpandedPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ani="using:CommunityToolkit.WinUI.Animations"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:HyPlayer.Controls"
    xmlns:frieren="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:hyplayer="using:HyPlayer"
    xmlns:lyricrenderer="using:HyPlayer.LyricRenderer"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    muxc:BackdropMaterial.ApplyToRootOrPageBackground="True"
    Loaded="Page_Loaded"
    NavigationCacheMode="Disabled">
    <Page.Resources>
        <!--  ReSharper disable once Xaml.RedundantResource  -->

        <Storyboard x:Key="ImageAlbumAni" x:Name="ImageAlbumAni">
            <DoubleAnimation
                x:Name="albumAniOpacity"
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="ImageAlbum"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0.8"
                Duration="0:0:4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                x:Name="albumAniScaleX"
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="ImageScale"
                Storyboard.TargetProperty="ScaleX"
                From="1"
                To="0.95"
                Duration="0:0:4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation
                x:Name="albumAniScaleY"
                AutoReverse="True"
                RepeatBehavior="Forever"
                Storyboard.TargetName="ImageScale"
                Storyboard.TargetProperty="ScaleY"
                From="1"
                To="0.95"
                Duration="0:0:4">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

        </Storyboard>
        <Storyboard x:Key="ImageResetPositionAni" x:Name="ImageResetPositionAni">
            <DoubleAnimation
                Storyboard.TargetName="ImagePositionOffset"
                Storyboard.TargetProperty="X"
                To="0"
                Duration="0:0:0.25" />
            <DoubleAnimation
                Storyboard.TargetName="ImagePositionOffset"
                Storyboard.TargetProperty="Y"
                To="0"
                Duration="0:0:0.25" />
        </Storyboard>
        <Storyboard x:Name="ShowAni" />
        <Storyboard x:Name="CollapseAni" />

        <media:AttachedCardShadow
            x:Key="AlbumShadow"
            x:Name="AlbumCoverDropShadow"
            BlurRadius="48"
            CornerRadius="16"
            Opacity="{x:Bind _settings.expandedCoverShadowDepth, Converter={StaticResource ShadowConverter}}"
            Offset="0, 4"
            Color="Black" />
    </Page.Resources>
    <!--  Grid Beam~  -->
    <Grid x:Name="PageContainer" Unloaded="LuminousBackground_OnUnloaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <!--  Title Bar  -->
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Rectangle
            x:Name="AcrylicCover"
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Fill="{ThemeResource ExpandedPlayerMask}" />
        <Rectangle
            x:Name="BlackCover"
            Grid.Row="0"
            Grid.RowSpan="3"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Canvas.ZIndex="-1"
            Opacity="0" />
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Grid.Column="0"
            Background="Transparent"
            Canvas.ZIndex="1" />
        <win2d:CanvasAnimatedControl
            x:Name="LuminousBackground"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Canvas.ZIndex="0"
            CreateResources="LuminousBackground_CreateResources"
            DoubleTapped="LyricView_DoubleTapped"
            Draw="LuminousBackground_Draw"
            PointerExited="LyricView_OnPointerExited"
            PointerMoved="LyricView_OnPointerMoved"
            PointerPressed="LyricView_OnPointerPressed"
            PointerReleased="LyricView_PointerReleased"
            PointerWheelChanged="LyricBoxContainer_OnPointerWheelChanged"
            RightTapped="LyricBoxContainer_RightTapped"
            SizeChanged="LuminousBackground_SizeChanged"
            Tapped="LyricBox_Tapped"
            Update="LuminousBackground_Update" />
        <Grid
            x:Name="LuminousBackgroundContainer"
            Grid.Row="0"
            Grid.RowSpan="3"
            Grid.Column="0"
            Canvas.ZIndex="-1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="BgRotate" CenterX="{x:Bind BgScale.CenterX, Mode=OneWay}" CenterY="{x:Bind BgScale.CenterY, Mode=OneWay}" />
                    <ScaleTransform x:Name="BgScale" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Rectangle
                x:Name="BgRect00"
                Grid.Row="0"
                Grid.Column="0" />
            <Rectangle
                x:Name="BgRect01"
                Grid.Row="0"
                Grid.Column="1" />
            <Rectangle
                x:Name="BgRect02"
                Grid.Row="0"
                Grid.Column="2" />
            <Rectangle
                x:Name="BgRect10"
                Grid.Row="1"
                Grid.Column="0" />
            <Rectangle
                x:Name="BgRect11"
                Grid.Row="1"
                Grid.Column="1" />
            <Rectangle
                x:Name="BgRect12"
                Grid.Row="1"
                Grid.Column="2" />
            <Rectangle
                x:Name="BgRect20"
                Grid.Row="2"
                Grid.Column="0" />
            <Rectangle
                x:Name="BgRect21"
                Grid.Row="2"
                Grid.Column="1" />
            <Rectangle
                x:Name="BgRect22"
                Grid.Row="2"
                Grid.Column="2" />
        </Grid>
        <Grid
            x:Name="MainGrid"
            Grid.Row="1"
            Margin="0,0,0,80"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ScrollViewer
                x:Name="UIAugmentationSys"
                Canvas.ZIndex="1"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled">
                <Grid
                    x:Name="LeftPanel"
                    MaxWidth="600"
                    HorizontalAlignment="Stretch"
                    Tapped="LeftPanel_Tapped">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="11*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="ShadowTarget" Grid.Row="1" />
                    <frieren:ImageEx
                        x:Name="ImageAlbum"
                        Source="{x:Bind ViewModel.Cover, Mode=OneWay}"
                        Grid.Row="1"
                        MaxWidth="600"
                        MaxHeight="600"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ui:Effects.Shadow="{StaticResource AlbumShadow}"
                        ui:VisualExtensions.NormalizedCenterPoint="0.5"
                        x:FieldModifier="public"
                        BorderBrush="Black"
                        BorderThickness="80"
                        CornerRadius="16"
                        IsCacheEnabled="False"
                        ManipulationCompleted="ImageAlbum_OnManipulationCompleted"
                        ManipulationDelta="ImageAlbum_OnManipulationDelta"
                        ManipulationMode="Rotate,TranslateX,TranslateY"
                        PlaceholderStretch="Uniform"
                        RightTapped="{x:Bind hyplayer:Common.UIElement_RightTapped}"
                        Stretch="Uniform">
                        <ani:Explicit.Animations>
                            <ani:AnimationSet x:Name="RotateAnimationSet">
                                <ani:RotationInDegreesAnimation
                                    x:Name="AlbumRotateAnimation"
                                    EasingMode="EaseOut"
                                    EasingType="Linear"
                                    Repeat="Forever"
                                    From="0"
                                    To="360"
                                    Duration="0:0:20" />
                            </ani:AnimationSet>
                        </ani:Explicit.Animations>
                        <frieren:ImageEx.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ImageScale" CenterX="300" CenterY="300" />
                                <TranslateTransform x:Name="ImagePositionOffset" />
                                <RotateTransform x:Name="ImageRotateTransform" CenterX="280" CenterY="280" />
                            </TransformGroup>
                        </frieren:ImageEx.RenderTransform>
                        <frieren:ImageEx.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="SaveAlbumImage_Click"
                                    Icon="Save"
                                    Style="{StaticResource MenuFlyoutItemRevealStyle}"
                                    Text="保存图片" />
                                <MenuFlyoutItem
                                    Click="CopySongName_Click"
                                    Icon="Copy"
                                    Style="{StaticResource MenuFlyoutItemRevealStyle}"
                                    Text="复制歌名" />
                            </MenuFlyout>
                        </frieren:ImageEx.ContextFlyout>
                    </frieren:ImageEx>
                    <StackPanel
                        x:Name="SongInfo"
                        Grid.Row="2"
                        MaxWidth="600"
                        VerticalAlignment="Top"
                        IsTapEnabled="True"
                        Orientation="Vertical"
                        Spacing="12">
                        <Grid
                            MaxWidth="600"
                            Margin="20,0,20,20"
                            CornerRadius="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="SongInfoContainer" Spacing="12">
                                <TextBlock
                                    x:Name="TextBlockSongTitle"
                                    Text="{x:Bind ViewModel.SongName, Mode=OneWay}"
                                    HorizontalAlignment="Center"
                                    FontSize="46"
                                    FontWeight="Bold"
                                    Foreground="{x:Bind hyplayer:Common.BrushManagement.AccentBrush, Mode=OneWay}"
                                    HorizontalTextAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />


                                <controls1:AlignableWrapPanel
                                    HorizontalContentAlignment="Center"
                                    HorizontalSpacing="12"
                                    Orientation="Horizontal"
                                    StretchChild="None"
                                    VerticalSpacing="-6">

                                    <HyperlinkButton
                                        Name="SingerHyperlinkBtn"
                                        Click="TextBlockSinger_OnTapped"
                                        FontSize="20"
                                        Foreground="{x:Bind hyplayer:Common.BrushManagement.AccentBrush, Mode=OneWay}"
                                        Style="{StaticResource TextBlockButtonStyle}">
                                        <controls1:AutoScrollView IsPlaying="True">
                                            <TextBlock Name="SingerTextBlock" Text="{x:Bind ViewModel.Artist, Mode=OneWay}"/>
                                        </controls1:AutoScrollView>
                                    </HyperlinkButton>
                                    <HyperlinkButton
                                        Name="AlbumHyperlinkBtn"
                                        Click="AlbumHyperlinkBtn_OnTapped"
                                        FontSize="20"
                                        Foreground="{x:Bind hyplayer:Common.BrushManagement.AccentBrush, Mode=OneWay}"
                                        Style="{StaticResource TextBlockButtonStyle}">
                                        <controls1:AutoScrollView IsPlaying="True">
                                            <TextBlock x:Name="AlbumTextBlock" Text="{x:Bind ViewModel.Album, Mode=OneWay}"/>
                                        </controls1:AutoScrollView>

                                    </HyperlinkButton>

                                </controls1:AlignableWrapPanel>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid
                x:Name="RightPanel"
                Grid.Column="1"
                HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DefaultRow" Height="25*" />
                    <RowDefinition x:Name="ImmersiveRow" Height="1*" />
                </Grid.RowDefinitions>
            </Grid>
            <Button
                x:Name="MoreBtn"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Width="40"
                Height="40"
                Margin="0,0,30,50"
                Padding="-5"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                x:FieldModifier="public"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="30"
                Style="{StaticResource ButtonRevealStyle}">
                <Button.Flyout>
                    <MenuFlyout>
                        <ToggleMenuFlyoutItem
                            Name="ToggleButtonTranslation"
                            HorizontalContentAlignment="Left"
                            Click="ToggleButtonTranslation_OnClick"
                            Text="显示翻译">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE982;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            Name="ToggleButtonSound"
                            HorizontalContentAlignment="Left"
                            Click="ToggleButtonSound_OnClick"
                            Text="转罗马字">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE986;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="BtnToggleFullScreen"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="BtnToggleFullScreen_Checked"
                            Text="全屏模式">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE1D9;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Name="BtnToggleTinyMode"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="BtnToggleTinyModeClick"
                            Text="小窗模式">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE2B3;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="BtnToggleAlbum"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="BtnToggleWindowsMode_Checked"
                            Text="专辑封面">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE15A;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <ToggleMenuFlyoutItem
                            x:Name="BtnToggleLyric"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            Click="BtnToggleWindowsMode_Checked"
                            Text="歌词界面">
                            <ToggleMenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE1A1;" />
                            </ToggleMenuFlyoutItem.Icon>
                        </ToggleMenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            HorizontalContentAlignment="Left"
                            Click="BtnCopyLyricClicked"
                            Text="复制歌词" />
                        <MenuFlyoutItem
                            HorizontalContentAlignment="Left"
                            Click="BtnLoadLocalLyric"
                            Text="加载本地歌词" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            HorizontalContentAlignment="Left"
                            IsEnabled="False"
                            Text="播放速度" />
                        <MenuFlyoutItem
                            HorizontalAlignment="Left"
                            Click="TbNowSpeed_OnTapped"
                            Text="恢复 x1" />
                        <MenuFlyoutItem DataContext="{x:Bind NowPlaybackSpeed, Mode=OneWay}">
                            <MenuFlyoutItem.Template>
                                <ControlTemplate>
                                    <controls:DockPanel LastChildFill="True">
                                        <Button controls:DockPanel.Dock="Left" Click="BtnSpeedMinusClick">-</Button>
                                        <Button controls:DockPanel.Dock="Right" Click="BtnSpeedPlusClick">+</Button>
                                        <TextBlock
                                            x:Name="TbNowSpeed"
                                            Text="{TemplateBinding MenuFlyoutItem.DataContext}"
                                            TextAlignment="Center" />
                                    </controls:DockPanel>
                                </ControlTemplate>
                            </MenuFlyoutItem.Template>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <ToggleMenuFlyoutItem
                            x:Name="ABRepeatState"
                            IsChecked="{x:Bind _settings.ABRepeatStatus, Mode=TwoWay}"
                            Text="AB循环" />
                        <MenuFlyoutItem
                            HorizontalContentAlignment="Left"
                            Click="SetABStartPointButton_Click"
                            Text="设置开始点" />
                        <MenuFlyoutItem
                            Name="ABStartPointItem"
                            HorizontalAlignment="Left"
                            Text="{x:Bind _settings.ABStartPointFriendlyValue, Mode=OneWay}" />
                        <MenuFlyoutItem
                            HorizontalContentAlignment="Left"
                            Click="SetABEndPointButton_Click"
                            Text="设置结束点" />
                        <MenuFlyoutItem
                            Name="ABEndPointItem"
                            HorizontalAlignment="Left"
                            Text="{x:Bind _settings.ABEndPointFriendlyValue, Mode=OneWay}" />
                    </MenuFlyout>
                </Button.Flyout>
                <Button.Content>
                    <FontIcon Foreground="{x:Bind hyplayer:Common.BrushManagement.AccentBrush, Mode=OneWay}" Glyph="&#xEDE3;" />
                </Button.Content>
            </Button>
        </Grid>

    </Grid>
</Page>