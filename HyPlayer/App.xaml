<Application
    x:Class="HyPlayer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:classes="using:HyPlayer.UI.Converters"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources />
                <ResourceDictionary Source="/Resources/Acrylic.xaml" />
                <ResourceDictionary Source="/Resources/UnsupportedFontIcon.xaml" />
                <ResourceDictionary Source="/UI/Converters/ConvertersDictionary.xaml" />
                <ResourceDictionary Source="/Resources/ListView.xaml" />
                <ResourceDictionary Source="/Resources/NavigationView.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  UI font selected in settings. AppFontService replaces this entry on startup;
                  XamlAutoFontFamily keeps the system default font.  -->
            <FontFamily x:Key="AppFontFamily">XamlAutoFontFamily</FontFamily>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>
            <Style TargetType="RichTextBlock">
                <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
            </Style>

            <Style x:Key="BaseStyle" TargetType="controls:ImageEx">
                <Setter Property="IsCacheEnabled" Value="False" />
            </Style>

            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="{StaticResource SubtleFillColorTertiary}" />
            <Color x:Key="SubtleFillColorTertiary">#0AFFFFFF</Color>

            <classes:NegationBoolToVisibilityConverter x:Key="NegationBoolToVisibilityConverter" />
            <!--  Theme dictionaries stay writable at runtime (a dictionary with a Source cannot be edited), so  -->
            <!--  AppFontService can point ContentControlThemeFontFamily at the font selected in settings.       -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Resources/Dark.xaml" />
                        <ResourceDictionary Source="/Resources/ThemeFont.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="/Resources/Light.xaml" />
                        <ResourceDictionary Source="/Resources/ThemeFont.xaml" />
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>