                                                    <StackPanel Width="345" Orientation="Vertical">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontWeight="Bold" Text="{x:Bind Name}" />
                                                            <TextBlock Foreground="Gray" Visibility="{x:Bind Translation, Converter={StaticResource EmptyStringToVisibilityConverter}}">
