                    </Button>
                    <Button
                        x:Name="BtnNextSong"
                        Grid.Column="5"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="BtnNextSong_OnClick"
                        CornerRadius="30">
                        <FontIcon
                            FontSize="{x:Bind IconPrevious.FontSize}"
                            Foreground="{x:Bind PlaybackAccentBrush, Mode=OneTime}"
                            Glyph="&#xF8AD;" />
                    </Button>
                    <Button
                        x:Name="BtnLike"
                        Grid.Column="6"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
