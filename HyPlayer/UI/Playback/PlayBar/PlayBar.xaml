                            x:Name="IconPrevious"
                            FontSize="15"
                            Foreground="{x:Bind PlaybackAccentBrush, Mode=OneTime}"
                            Glyph="&#xF8AC;" />
                    </Button>
                    <Button
                        x:Name="BtnPlayStateChange"
