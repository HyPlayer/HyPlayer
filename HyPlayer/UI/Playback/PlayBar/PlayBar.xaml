                                                        <FontIcon
                                                            HorizontalAlignment="Left"
                                                            FontSize="16"
                                                            Glyph="&#xE10A;" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
