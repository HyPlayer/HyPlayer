                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="24"
                                    Glyph="&#xE90B;" />
                                <frieren:ImageEx
                                    x:Name="AlbumImage"
                                    IsCacheEnabled="False"
                                    PlaceholderStretch="Uniform"
                                    Stretch="UniformToFill">
                                    <frieren:ImageEx.Source>
                                        <BitmapImage x:Name="AlbumImageSource" />
                                    </frieren:ImageEx.Source>
                                </frieren:ImageEx>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid
