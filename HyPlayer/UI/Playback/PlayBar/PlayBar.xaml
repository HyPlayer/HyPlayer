                                                                <Run Text="{x:Bind Translation}" />
                                                                <Run Text=")" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <TextBlock Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Text="{x:Bind ArtistText}" />
