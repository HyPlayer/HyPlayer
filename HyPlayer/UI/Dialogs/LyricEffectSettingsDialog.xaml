<ContentDialog
    x:Class="HyPlayer.UI.Dialogs.LyricEffectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HyPlayer.UI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="歌词特效链"
    CloseButtonClick="Dialog_CloseButtonClick"
    CloseButtonText="取消"
    Closed="Dialog_Closed"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="保存"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1120</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
        <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="IdleBrush" Color="{ThemeResource SystemBaseMediumColor}" />
    </ContentDialog.Resources>

    <Grid Width="1080" Height="700">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3.5*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                Margin="4,0,0,10"
                FontSize="18"
                FontWeight="SemiBold"
                Text="活动操作链" />
            <ListView
                x:Name="OperationList"
                Grid.Row="1"
                AllowDrop="True"
                CanReorderItems="True"
                DragItemsCompleted="OperationList_DragItemsCompleted"
                IsItemClickEnabled="False"
                ItemsSource="{x:Bind OperationsView}"
                ReorderMode="Enabled"
                SelectionChanged="OperationList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:LyricEffectOperationItem">
                        <Grid MinHeight="76" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                IsEnabled="{Binding CanToggle}"
                                IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="4,0,8,0"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                               Text="{Binding CategoryLabel}" />
                                    <TextBlock
                                        Text="{Binding DisplayName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    MaxLines="2"
                                    Opacity="0.65"
                                    Text="{Binding Description}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Button
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="更多操作">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Click="MoveUp_Click"
                                            Tag="{Binding InstanceId}"
                                            Text="上移" />
                                        <MenuFlyoutItem
                                            Click="MoveDown_Click"
                                            Tag="{Binding InstanceId}"
                                            Text="下移" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem
                                            Click="Duplicate_Click"
                                            IsEnabled="{Binding CanDuplicate}"
                                            Tag="{Binding InstanceId}"
                                            Text="复制" />
                                        <MenuFlyoutItem
                                            Click="Delete_Click"
                                            IsEnabled="{Binding CanDelete}"
                                            Tag="{Binding InstanceId}"
                                            Text="删除" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="添加节点">
                        <Button.Flyout>
                            <MenuFlyout x:Name="OperationPresetFlyout" />
                        </Button.Flyout>
                    </Button>
                    <Button Content="预设">
                        <Button.Flyout>
                            <MenuFlyout x:Name="ProfilePresetFlyout" />
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Click="Import_Click" Content="导入" />
                    <Button Click="Export_Click" Content="导出" />
                </StackPanel>
                <TextBlock
                    x:Name="StatusText"
                    Margin="4,8,4,0"
                    Foreground="OrangeRed"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border
                Margin="0,0,0,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <win2d:CanvasAnimatedControl
                        x:Name="PreviewCanvas"
                        Draw="PreviewCanvas_Draw"
                        SizeChanged="PreviewCanvas_SizeChanged" />
                    <TextBlock
                        Margin="12"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        FontSize="12"
                        Opacity="0.6"
                        Text="实时三行预览" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    x:Name="EditorPanel"
                    Padding="4,8,12,20"
                    Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
