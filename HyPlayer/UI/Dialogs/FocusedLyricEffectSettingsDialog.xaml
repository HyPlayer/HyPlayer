<ContentDialog
    x:Class="HyPlayer.UI.Dialogs.FocusedLyricEffectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HyPlayer.UI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="聚焦歌词特效链"
    CloseButtonText="取消"
    Closed="Dialog_Closed"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="保存"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1120</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1080" Height="700">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="4,0,0,10" FontSize="18" FontWeight="SemiBold" Text="聚焦操作链" />
            <ListView
                x:Name="OperationList"
                AutomationProperties.AutomationId="FocusedOperationList"
                Grid.Row="1"
                AllowDrop="True"
                CanReorderItems="True"
                DragItemsCompleted="OperationList_DragItemsCompleted"
                ItemsSource="{x:Bind Operations}"
                ReorderMode="Enabled"
                SelectionChanged="OperationList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FocusedTextOperationItem">
                        <Grid MinHeight="68" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                AutomationProperties.AutomationId="{x:Bind ToggleAutomationId, Mode=OneWay}"
                                VerticalAlignment="Center"
                                IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Opacity="0.65" Text="{x:Bind TargetSummary, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="AddFocusedEffect" Content="添加节点">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AddOperationFlyout" />
                        </Button.Flyout>
                    </Button>
                    <Button AutomationProperties.AutomationId="DeleteFocusedEffect" Click="DeleteOperation_Click" Content="删除" />
                    <Button AutomationProperties.AutomationId="MoveFocusedEffectUp" Click="MoveUp_Click" Content="上移" />
                    <Button AutomationProperties.AutomationId="MoveFocusedEffectDown" Click="MoveDown_Click" Content="下移" />
                </StackPanel>
                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button AutomationProperties.AutomationId="ResetFocusedEffects" Click="ResetPreset_Click" Content="恢复默认聚焦链" />
                    <Button AutomationProperties.AutomationId="UseSoftLiftPreset" Click="SoftLiftPreset_Click" Content="柔和抬升" />
                    <Button AutomationProperties.AutomationId="ImportFocusedEffects" Click="Import_Click" Content="导入完整配置" />
                    <Button AutomationProperties.AutomationId="ExportFocusedEffects" Click="Export_Click" Content="导出" />
                </controls:WrapPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <win2d:CanvasAnimatedControl
                        x:Name="PreviewCanvas"
                        Draw="PreviewCanvas_Draw"
                        SizeChanged="PreviewCanvas_SizeChanged" />
                    <StackPanel Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" Spacing="6">
                        <ComboBox
                            x:Name="PreviewModeCombo"
                            AutomationProperties.AutomationId="FocusedPreviewMode"
                            SelectionChanged="PreviewMode_SelectionChanged">
                            <ComboBoxItem Content="真实 Word" Tag="Timed" />
                            <ComboBoxItem Content="推断 Word" Tag="Inferred" />
                            <ComboBoxItem Content="无 Word" Tag="Direct" />
                        </ComboBox>
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Opacity="0.65" Text="Reveal 与 GlyphLift 正交预览" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel" Padding="4,8,12,20" Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
