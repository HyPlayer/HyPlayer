<ContentDialog
    x:Class="HyPlayer.UI.Dialogs.FocusedLyricEffectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="高亮歌词特效" PrimaryButtonText="保存" CloseButtonText="取消" DefaultButton="Primary"
    PrimaryButtonClick="Dialog_Save" Closed="Dialog_Closed">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">1000</x:Double>
    </ContentDialog.Resources>
    <Grid Width="900" Height="600">
        <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="EditorPanel" Margin="0,0,20,0" Spacing="10"/>
        </ScrollViewer>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="效果预览" FontSize="18" Margin="0,0,0,12"/>
            <win2d:CanvasAnimatedControl x:Name="PreviewCanvas" Grid.Row="1" Draw="Preview_Draw" SizeChanged="Preview_SizeChanged" Unloaded="Preview_Unloaded"/>
            <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
    </Grid>
</ContentDialog>
