<ContentDialog
    x:Class="HyPlayer.UI.Dialogs.FocusedLyricEffectSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HyPlayer.UI.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="聚焦歌词特效链"
    CloseButtonText="取消"
    Closed="Dialog_Closed"
    DefaultButton="Primary"
    PrimaryButtonClick="Dialog_PrimaryButtonClick"
    PrimaryButtonText="保存"
    mc:Ignorable="d">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMinWidth">1120</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">1200</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">900</x:Double>
    </ContentDialog.Resources>

    <Grid Width="1080" Height="700">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="4,0,0,10" FontSize="18" FontWeight="SemiBold" Text="聚焦操作链" />
            <ListView
                x:Name="OperationList"
                Grid.Row="1"
                AllowDrop="True"
                CanReorderItems="True"
                DragItemsCompleted="OperationList_DragItemsCompleted"
                ItemsSource="{x:Bind Operations}"
                ReorderMode="Enabled"
                SelectionChanged="OperationList_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:FocusedTextOperationItem">
                        <Grid MinHeight="68" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                VerticalAlignment="Center"
                                IsOn="{Binding IsEnabled, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                            <StackPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Opacity="0.65" Text="{Binding TargetSummary}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="添加节点">
                        <Button.Flyout>
                            <MenuFlyout x:Name="AddOperationFlyout" />
                        </Button.Flyout>
                    </Button>
                    <Button Click="DeleteOperation_Click" Content="删除" />
                    <Button Click="MoveUp_Click" Content="上移" />
                    <Button Click="MoveDown_Click" Content="下移" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="ResetPreset_Click" Content="恢复默认聚焦链" />
                    <Button Click="Import_Click" Content="导入完整配置" />
                    <Button Click="Export_Click" Content="导出" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="OrangeRed" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Margin="0,0,0,4" Text="非逐词行" />
                    <ComboBox x:Name="UntimedModeCombo" HorizontalAlignment="Stretch" SelectionChanged="GlobalMode_SelectionChanged">
                        <ComboBoxItem Content="整行直接高亮" Tag="DirectHighlight" />
                        <ComboBoxItem Content="自动推断 Word" Tag="InferWords" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,4" Text="高亮推进" />
                    <ComboBox x:Name="RevealModeCombo" HorizontalAlignment="Stretch" SelectionChanged="GlobalMode_SelectionChanged">
                        <ComboBoxItem Content="矩形裁切" Tag="RectangleClip" />
                        <ComboBoxItem Content="逐 Glyph" Tag="GlyphStep" />
                        <ComboBoxItem Content="整 Word" Tag="WholeWord" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,4" Text="音译推进" />
                    <ComboBox x:Name="TransliterationModeCombo" HorizontalAlignment="Stretch" SelectionChanged="GlobalMode_SelectionChanged">
                        <ComboBoxItem Content="跟随正文" Tag="FollowMain" />
                        <ComboBoxItem Content="整行显示" Tag="WholeLine" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Margin="0,0,0,4" Text="预览歌词" />
                    <ComboBox x:Name="PreviewModeCombo" HorizontalAlignment="Stretch" SelectionChanged="PreviewMode_SelectionChanged">
                        <ComboBoxItem Content="真实逐词" Tag="Timed" />
                        <ComboBoxItem Content="推断 Word" Tag="Inferred" />
                        <ComboBoxItem Content="直接高亮" Tag="Direct" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,0,0,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <win2d:CanvasAnimatedControl
                        x:Name="PreviewCanvas"
                        Draw="PreviewCanvas_Draw"
                        SizeChanged="PreviewCanvas_SizeChanged" />
                    <TextBlock Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="12" Opacity="0.65" Text="Reveal 与 Motion 独立预览" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="EditorPanel" Padding="4,8,12,20" Spacing="10" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
