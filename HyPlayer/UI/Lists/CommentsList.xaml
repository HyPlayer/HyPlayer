<UserControl
    x:Class="HyPlayer.UI.Lists.CommentsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HyPlayer.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="CommentsContainer"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            ItemContainerStyle="{ThemeResource ListViewItemStyle}"
            ItemsSource="{x:Bind Comments}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate ScrollViewer.CanContentRenderOutsideBounds="False">
                    <Border>
                        <local:SingleComment MainComment="{Binding}" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>