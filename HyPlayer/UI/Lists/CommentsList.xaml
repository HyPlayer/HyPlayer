<UserControl
    x:Class="HyPlayer.UI.Lists.CommentsList"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HyPlayer.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:playcore="using:HyPlayer.PlayCore.Abstraction.Models.SingleItems"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid>
        <ListView
            x:Name="CommentsContainer"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            DataFetchSize="1"
            IncrementalLoadingThreshold="1"
            IncrementalLoadingTrigger="Edge"
            ItemContainerStyle="{ThemeResource ListViewItemStyle}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="playcore:CommentBase" ScrollViewer.CanContentRenderOutsideBounds="False">
                    <Border>
                        <local:SingleComment MainComment="{x:Bind}" />
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Border
                    x:Name="IncrementalLoadSentinel"
                    Height="1"
                    EffectiveViewportChanged="IncrementalLoadSentinel_EffectiveViewportChanged" />
            </ListView.Footer>
        </ListView>
    </Grid>
</UserControl>
