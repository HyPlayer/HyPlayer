<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Theme-scoped on purpose: the framework's implicit TextBlock style also lives in a theme dictionary,
        so an app-level implicit style would lose against it. The font itself comes from the plain
        AppFontFamily entry in App.xaml, which AppFontService replaces when a UI font is selected.
    -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
    </Style>
    <Style TargetType="RichTextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource AppFontFamily}" />
    </Style>
</ResourceDictionary>
