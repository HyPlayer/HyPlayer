<Page
    x:Class="HyPlayer.Features.ListenTogether.ListenTogetherPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HyPlayer.Features.ListenTogether"
    xmlns:models="using:HyPlayer.PlayCore.Abstraction.Models"
    Loaded="Page_Loaded"
    NavigationCacheMode="Disabled"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style x:Key="ListenTogetherCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style
            x:Key="ListenTogetherCardTitleStyle"
            BasedOn="{StaticResource SubtitleTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="ListenTogetherHintStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="1100" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="30,30,30,40" Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="40"
                            FontWeight="Bold"
                            Text="一起听" />
                        <TextBlock
                            Style="{StaticResource ListenTogetherHintStyle}"
                            Text="{x:Bind Service.StatusMessage, Mode=OneWay}" />
                    </StackPanel>

                    <Border Style="{StaticResource ListenTogetherCardStyle}" Visibility="{x:Bind Service.HasExistingRoom, Mode=OneWay}">
                        <Grid ColumnSpacing="16" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <FontIcon
                                VerticalAlignment="Top"
                                FontSize="28"
                                Glyph="&#xE716;" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock
                                    Style="{StaticResource ListenTogetherCardTitleStyle}"
                                    Text="{x:Bind Service.ExistingRoomText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource ListenTogetherHintStyle}" Text="" />
                            </StackPanel>
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Click="TakeOver_Click"
                                    Content="在本机接管"
                                    Style="{ThemeResource AccentButtonStyle}" />
                                <Button Click="EndExisting_Click" Content="结束这个一起听" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid
                        x:Name="StartGrid"
                        ColumnSpacing="16"
                        RowSpacing="16"
                        Visibility="{x:Bind Service.IsIdle, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="DualCard" Style="{StaticResource ListenTogetherCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontSize="20" Glyph="&#xE716;" />
                                    <TextBlock Style="{StaticResource ListenTogetherCardTitleStyle}" Text="双人一起听" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ListenTogetherHintStyle}" Text="" />
                                <Button
                                    Click="CreateRoom_Click"
                                    Content="创建双人房间"
                                    IsEnabled="{x:Bind Service.CanCreate, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="MultiCard"
                            Grid.Column="1"
                            Style="{StaticResource ListenTogetherCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon FontSize="20" Glyph="&#xE902;" />
                                    <TextBlock Style="{StaticResource ListenTogetherCardTitleStyle}" Text="多人一起听" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource ListenTogetherHintStyle}" Text="" />
                                <Button
                                    Click="CreateMultiRoom_Click"
                                    Content="创建多人房间"
                                    IsEnabled="{x:Bind Service.CanCreate, Mode=OneWay}"
                                    Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="JoinCard"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Style="{StaticResource ListenTogetherCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource ListenTogetherCardTitleStyle}" Text="加入好友的一起听" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="InviteBox"
                                        AutomationProperties.Name="邀请链接"
                                        PlaceholderText="粘贴邀请链接，或输入 房间号 邀请人ID" />
                                    <Button
                                        Grid.Column="1"
                                        Click="JoinRoom_Click"
                                        Content="加入"
                                        IsEnabled="{x:Bind Service.CanCreate, Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    x:Name="InviteError"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="无法识别邀请链接或房间号"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid
                        x:Name="RoomGrid"
                        ColumnSpacing="16"
                        RowSpacing="16"
                        Visibility="{x:Bind Service.IsInRoom, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="RoomCard" Style="{StaticResource ListenTogetherCardStyle}">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource ListenTogetherCardTitleStyle}" Text="{x:Bind local:ListenTogetherPage.ModeTitle(Service.IsMulti), Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource ListenTogetherHintStyle}" Text="{x:Bind local:ListenTogetherPage.RoleText(Service.IsHost), Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="房间成员" />
                                <GridView
                                    MaxHeight="232"
                                    IsItemClickEnabled="False"
                                    ItemsSource="{x:Bind Service.Users, Mode=OneWay}"
                                    SelectionMode="None">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProviderListenTogetherUser">
                                            <StackPanel Width="88" Spacing="6">
                                                <PersonPicture
                                                    Width="56"
                                                    Height="56"
                                                    DisplayName="{x:Bind Nickname}"
                                                    ProfilePicture="{x:Bind local:ListenTogetherPage.Avatar(AvatarUrl)}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    Text="{x:Bind Nickname}"
                                                    TextAlignment="Center"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel Spacing="8" Visibility="{x:Bind Service.IsMulti, Mode=OneWay}">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="待播列表" />
                                            <TextBlock
                                                FontSize="12"
                                                Style="{StaticResource ListenTogetherHintStyle}"
                                                Text="" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="RequestSkip_Click"
                                            Content="想切歌"
                                            IsEnabled="{x:Bind Service.CanRequestSkip, Mode=OneWay}" />
                                    </Grid>
                                    <ListView
                                        MaxHeight="420"
                                        IsItemClickEnabled="False"
                                        ItemsSource="{x:Bind Service.MultiQueue, Mode=OneWay}"
                                        SelectionMode="None">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0,0,12,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:ProviderMultiListenTogetherQueueItem">
                                                <Grid Padding="0,6" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border
                                                        Width="44"
                                                        Height="44"
                                                        CornerRadius="6">
                                                        <Image Source="{x:Bind local:ListenTogetherPage.Cover(CoverUrl)}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                        <TextBlock
                                                            FontWeight="{x:Bind local:ListenTogetherPage.TitleWeight(IsPlaying)}"
                                                            Text="{x:Bind Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Opacity="0.7"
                                                            Text="{x:Bind Artists}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Opacity="0.7"
                                                        Text="{x:Bind local:ListenTogetherPage.RecommenderText(RecommenderName, IsSystemRecommendation, IsPlaying)}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ListenTogetherHintStyle}" Text="" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="Reconnect_Click"
                                        Content="重新连接"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Visibility="{x:Bind Service.IsDisconnected, Mode=OneWay}" />
                                    <Button Click="EndRoom_Click" Content="{x:Bind local:ListenTogetherPage.EndText(Service.IsMulti), Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="InviteCard"
                            Grid.Column="1"
                            Style="{StaticResource ListenTogetherCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource ListenTogetherCardTitleStyle}" Text="邀请好友" />
                                <Border
                                    Width="200"
                                    Height="200"
                                    Padding="8"
                                    HorizontalAlignment="Center"
                                    Background="White"
                                    CornerRadius="8">
                                    <Image x:Name="QrImage" AutomationProperties.Name="邀请二维码" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource ListenTogetherHintStyle}"
                                    Text="用网易云音乐 App 扫码，或把链接发给好友" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        AutomationProperties.Name="邀请链接"
                                        IsReadOnly="True"
                                        Text="{x:Bind Service.ShareLink, Mode=OneWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="CopyLink_Click"
                                        Content="复制" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DualCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="MultiCard.(Grid.Column)" Value="0" />
                        <Setter Target="MultiCard.(Grid.Row)" Value="1" />
                        <Setter Target="MultiCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="JoinCard.(Grid.Row)" Value="2" />
                        <Setter Target="RoomCard.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="InviteCard.(Grid.Column)" Value="0" />
                        <Setter Target="InviteCard.(Grid.Row)" Value="1" />
                        <Setter Target="InviteCard.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</Page>
