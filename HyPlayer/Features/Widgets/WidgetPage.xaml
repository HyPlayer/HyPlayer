<Page
    x:Class="HyPlayer.Features.Widgets.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:win2d="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Background="Transparent"
    PointerEntered="WidgetPage_PointerEntered"
    PointerExited="WidgetPage_PointerExited"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemBaseHighColor}" />
        <SolidColorBrush x:Key="IdleBrush" Color="{ThemeResource SystemBaseMediumColor}" />
    </Page.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
        </Grid.RowDefinitions>
        <Border
            x:Name="BorderBackground"
            Grid.RowSpan="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefault}"
            BorderThickness="1"
            CornerRadius="8" />
        <win2d:CanvasAnimatedControl
            x:Name="LyricView"
            DoubleTapped="LyricView_DoubleTapped"
            Draw="LyricView_Draw"
            PointerExited="LyricView_PointerExited"
            PointerMoved="LyricView_PointerMoved"
            PointerPressed="LyricView_PointerPressed"
            PointerReleased="LyricView_PointerReleased"
            PointerWheelChanged="LyricView_PointerWheelChanged"
            SizeChanged="LyricView_SizeChanged" />
        <Grid x:Name="TipContent" Grid.Row="0">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{ThemeResource SubtitleTextBlockStyle}"
                    Text="HyPlayer 桌面歌词小部件" />
                <TextBlock HorizontalAlignment="Center" Text="无歌曲。启动应用并播放歌曲后点击“重试”按钮以继续" />
                <Button
                    x:Name="FindLyricButton"
                    HorizontalAlignment="Center"
                    Click="FindLyricButton_Click"
                    Content="重试" />
            </StackPanel>
        </Grid>
        <!--  这个透明Border用于触发鼠标事件  -->
        <Border Grid.Row="1" Background="Transparent" />
        <Grid
            x:Name="PlayBar"
            Grid.Row="1"
            Margin="0"
            Padding="4"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefault}"
            BorderThickness="1"
            Canvas.ZIndex="1"
            CornerRadius="0,0,8,8">
            <muxc:ProgressBar
                x:Name="PositionProgressBar"
                Margin="-4,-4,-4,0"
                VerticalAlignment="Top" />
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  上一首  -->
                <Button
                    x:Name="MovePreviousButton"
                    Grid.Column="0"
                    Width="42"
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="MovePreviousButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE892;" />
                </Button>
                <!--  暂停/继续  -->
                <Button
                    x:Name="ChangePlayStateButton"
                    Grid.Column="1"
                    Width="45"
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="ChangePlayStateButton_Click">
                    <FontIcon x:Name="PlayStateIcon" Glyph="&#xE769;" />
                </Button>
                <!--  下一首  -->
                <Button
                    x:Name="MoveNextButton"
                    Grid.Column="2"
                    Width="42"
                    Height="36"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="MoveNextButton_Click">
                    <FontIcon FontSize="14" Glyph="&#xE893;" />
                </Button>

                <TextBlock
                    Grid.Column="3"
                    Margin="12,0,0,4"
                    VerticalAlignment="Center"
                    FontSize="16"
                    TextTrimming="CharacterEllipsis">
                    <Run x:Name="SongNameText" />
                    <Run x:Name="ArtistText" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                </TextBlock>
                <TextBlock
                    x:Name="CurrentPositionText"
                    Grid.Column="4"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontSize="16" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="5"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Click="CloseButton_Click"
                    Content="{ui:FontIcon FontSize=16,
                                          Glyph=&#xE711;}" />
            </Grid>
        </Grid>
    </Grid>
</Page>