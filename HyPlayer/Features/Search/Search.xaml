<Page
    x:Class="HyPlayer.Features.Search.Search"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:history="using:HyPlayer.Features.History.Services"
    xmlns:hycontrol="using:HyPlayer.UI.Lists"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">


    <Grid Margin="24,24,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            Margin="0,-5,0,20"
            CharacterSpacing="90"
            FontSize="40"
            FontWeight="Bold"
            Text="搜索歌曲" />
        <StackPanel
            Grid.Row="1"
            Orientation="Vertical"
            Spacing="10">
            <ComboBox
                x:Name="HistoryComboBox"
                Margin="15,0,15,5"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind history:HistoryManagement.GetSearchHistory()}"
                PlaceholderText="展开搜索历史"
                SelectionChanged="HistoryComboBox_SelectionChanged" />
        </StackPanel>
        <NavigationView
            x:Name="NavigationViewSelector"
            Grid.Row="2"
            Margin="-10,0,0,0"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="NavigationView_OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="单曲" Tag="1" />
                <NavigationViewItem Content="专辑" Tag="10" />
                <NavigationViewItem Content="歌手" Tag="100" />
                <NavigationViewItem Content="歌单" Tag="1000" />
                <NavigationViewItem Content="用户" Tag="1002" />
                <NavigationViewItem Content="MV" Tag="1004" />
                <NavigationViewItem Content="歌词" Tag="1006" />
                <NavigationViewItem Content="电台" Tag="1009" />
                <NavigationViewItem Content="视频" Tag="1014" />
                <!-- <NavigationViewItem Content="综合" Tag="1018" /> -->
            </NavigationView.MenuItems>
            <Grid>
                <Grid Margin="0,-30,0,0" VerticalAlignment="Stretch">
                    <hycontrol:ContainerItemsView
                        x:Name="SearchResultContainer"
                        Margin="0,30,0,0"
                        Container="{x:Bind CurrentResultContainer, Mode=OneWay}" />
                    <TextBlock
                        x:Name="TBNoRes"
                        Margin="0,100,0,0"
                        HorizontalAlignment="Center"
                        FontSize=" 18"
                        Text="没有搜索到相关内容" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>

</Page>
