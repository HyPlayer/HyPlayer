<Page
    x:Class="HyPlayer.Features.Artist.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:HyPlayer.UI.Lists"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:uiControls="using:HyPlayer.UI.Controls"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush
                        x:Key="ArtistPageAcrylicBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="{ThemeResource SystemRevealAltMediumHighColor}"
                        TintColor="{ThemeResource SystemRevealAltHighColor}"
                        TintLuminosityOpacity="0.5"
                        TintOpacity="0.5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>


    <Grid>
        <uiControls:PivotView x:Name="ArtistPivotView" HeaderScrollProgressChanged="OnArtistHeaderScrollProgressChanged">
            <uiControls:PivotView.Header>
                <Grid Padding="32">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Rectangle
                        x:Name="RectangleImageBack"
                        Grid.RowSpan="2"
                        Margin="-32">
                        <Rectangle.Fill>
                            <ImageBrush
                                x:Name="ImageRect1"
                                ImageSource="{x:Bind ViewModel.Image, Mode=OneWay}"
                                Stretch="UniformToFill" />
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle
                        x:Name="RectangleImageBackAcrylic"
                        Grid.RowSpan="2"
                        Margin="-32"
                        Fill="{ThemeResource SystemControlAcrylicElementBrush}" />
                    <controls:DockPanel
                        x:Name="GridPersonalInformation"
                        Grid.Row="0"
                        LastChildFill="True">

                        <Rectangle
                            x:Name="RectangleImage"
                            Width="120"
                            Height="120"
                            Margin="0,0,0,0"
                            controls:DockPanel.Dock="Left"
                            RadiusX="10"
                            RadiusY="10">
                            <Rectangle.Fill>
                                <ImageBrush
                                    x:Name="ImageRect"
                                    ImageSource="{x:Bind ViewModel.Image, Mode=OneWay}"
                                    Stretch="UniformToFill" />
                            </Rectangle.Fill>
                            <Rectangle.RenderTransform>
                                <ScaleTransform x:Name="UserScale" CenterX="100" CenterY="100" />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <StackPanel
                            Name="StackPanelUserInfo"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TextBoxArtistName"
                                Style="{StaticResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Artist.Name, Mode=OneWay}"
                                TextWrapping="Wrap" />

                            <StackPanel.RenderTransform>
                                <ScaleTransform x:Name="UserInfoScale" CenterY="125" />
                            </StackPanel.RenderTransform>
                        </StackPanel>

                    </controls:DockPanel>
                    <uiControls:ExpandableTextBox
                        x:Name="TextBlockDesc"
                        Grid.Row="1"
                        Margin="0,12,0,0"
                        FontSize="15"
                        Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                        MaxLines="7"
                        Selectable="True"
                        Text="{x:Bind ViewModel.Artist.Description, Mode=OneWay}"
                        TextWrapping="WrapWholeWords">
                        <uiControls:ExpandableTextBox.RenderTransform>
                            <ScaleTransform x:Name="DescScale" CenterX="125" CenterY="0" />
                        </uiControls:ExpandableTextBox.RenderTransform>
                    </uiControls:ExpandableTextBox>
                    <ui:Effects.Shadow>
                        <media:AttachedCardShadow
                            CornerRadius="0"
                            Opacity="0.5"
                            Offset="0,1,0"
                            Color="Black" />
                    </ui:Effects.Shadow>
                </Grid>
            </uiControls:PivotView.Header>

            <uiControls:PivotEx
                x:Name="MainPivot"
                Margin="0,-32,0,0"
                AllowFocusOnInteraction="False"
                IsTabStop="False"
                SelectedIndex="{x:Bind ViewModel.CurrentPivotIndex, Mode=TwoWay}">
                <PivotItem Header="热门50首">
                    <controls1:ContainerItemsView x:Name="HotSongContainer" Container="{x:Bind ViewModel.HotSongsContainer, Mode=OneWay}">
                        <controls1:ContainerItemsView.ListHeader>
                            <Rectangle Height="{x:Bind ArtistPivotView.HeaderHeight, Mode=OneWay}" />
                        </controls1:ContainerItemsView.ListHeader>
                    </controls1:ContainerItemsView>
                </PivotItem>
                <PivotItem Header="全部歌曲">
                    <controls1:ContainerItemsView x:Name="AllSongContainer" Container="{x:Bind ViewModel.AllSongsContainer, Mode=OneWay}">
                        <controls1:ContainerItemsView.ListHeader>
                            <Rectangle Height="{x:Bind ArtistPivotView.HeaderHeight, Mode=OneWay}" />
                        </controls1:ContainerItemsView.ListHeader>
                    </controls1:ContainerItemsView>
                </PivotItem>
                <PivotItem Header="专辑">
                    <controls1:ContainerItemsView x:Name="AlbumContainer" Container="{x:Bind ViewModel.AlbumsContainer, Mode=OneWay}">
                        <controls1:ContainerItemsView.ListHeader>
                            <Rectangle Height="{x:Bind ArtistPivotView.HeaderHeight, Mode=OneWay}" />
                        </controls1:ContainerItemsView.ListHeader>
                    </controls1:ContainerItemsView>
                </PivotItem>
            </uiControls:PivotEx>
        </uiControls:PivotView>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RectangleImage.Visibility" Value="Collapsed" />
                        <Setter Target="StackPanelUserInfo.(Grid.Column)" Value="1" />
                        <Setter Target="StackPanelUserInfo.(Grid.ColumnSpan)" Value="10" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1024" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RectangleImage.Visibility" Value="Visible" />
                        <Setter Target="StackPanelUserInfo.(Grid.Column)" Value="5" />
                        <Setter Target="StackPanelUserInfo.(Grid.ColumnSpan)" Value="6" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>


</Page>
