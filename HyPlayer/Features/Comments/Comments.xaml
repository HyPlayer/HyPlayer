<Page
    x:Class="HyPlayer.Features.Comments.Comments"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hycontrols="using:HyPlayer.UI.Lists"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Disabled"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">
    <Grid>
        <Grid
            Margin="15,20,15,0"
            VerticalAlignment="Top"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="CommentEdit"
                Grid.Column="0"
                Height="80"
                AcceptsReturn="True"
                MaxLength="140"
                PlaceholderText="发表评论"
                TextWrapping="Wrap" />
            <Button
                x:Name="SendComment"
                Grid.Column="1"
                Width="80"
                Height="80"
                Click="SendComment_Click"
                Content="发表"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
        <Grid
            x:Name="CommentsContainer"
            Margin="0,110,0,0"
            VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    x:Name="AllCmtsTB"
                    Margin="25,10,15,10"
                    FontSize="24"
                    FontWeight="Bold"
                    Text="所有评论" />
                <ComboBox
                    x:Name="ComboBoxSortType"
                    Margin="0,8,16,0"
                    SelectedIndex="2"
                    SelectionChanged="ComboBoxSortType_OnSelectionChanged">
                    <x:String>推荐</x:String>
                    <x:String>热度</x:String>
                    <x:String>时间</x:String>
                </ComboBox>
            </StackPanel>
            <hycontrols:CommentsList
                x:Name="NormalComments"
                Margin="0,40,0,190"
                Comments="{x:Bind ViewModel.Comments, Mode=OneWay}"
                Loaded="MainComments_Loaded" />
            <StackPanel
                Margin="135"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Spacing="4">
                <TextBlock
                    x:Name="PageIndicator"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    Text="{x:Bind ViewModel.Page, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button
                        x:Name="PrevPage"
                        Click="PrevPage_Click"
                        Content="上一页"
                        IsEnabled="{x:Bind ViewModel.HasPreviousPage, Mode=OneWay}" />
                    <AutoSuggestBox
                        x:Name="PageSelect"
                        Width="110"
                        PlaceholderText="跳页"
                        QueryIcon="Forward"
                        QuerySubmitted="PageSelect_QuerySubmitted" />
                    <Button
                        x:Name="NextPage"
                        Click="NextPage_Click"
                        Content="下一页"
                        IsEnabled="{x:Bind ViewModel.HasNextPage, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Button
            x:Name="BackToTop"
            Width="50"
            Height="50"
            Margin="15"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Click="BackToTop_Click"
            CornerRadius="5"
            ToolTipService.ToolTip="回到顶部"
            Visibility="Collapsed">
            <SymbolIcon Symbol="Up" />
        </Button>
    </Grid>
</Page>
