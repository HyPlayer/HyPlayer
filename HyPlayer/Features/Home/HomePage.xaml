<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HyPlayer.Features.Home.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:home="using:HyPlayer.Features.Home"
    xmlns:communityBehaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:HyPlayer.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyplayer="using:HyPlayer.Infrastructure.Extensions"
    xmlns:lists="using:HyPlayer.UI.Lists"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="RecommendedCardTemplate" x:DataType="home:HomeContainerCardViewModel">
            <ListViewItem
                x:Name="Card"
                Width="256"
                Height="128"
                Margin="2,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tag="{x:Bind}"
                Tapped="Card_Tapped">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid HorizontalAlignment="Left" RightTapped="{x:Bind hyplayer:XamlHelpers.UIElement_RightTapped}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind CoverUrl}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Column="1"
                        Margin="16,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind CreatorName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind CreatorName}" />
                    </Grid>

                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="MenuFlyoutItem_Click"
                                CommandParameter="{x:Bind}"
                                Icon="Play"
                                Text="播放全部" />
                            <MenuFlyoutItem
                                x:Name="ItemPublicPlayList"
                                Click="ItemPublicPlayList_Click"
                                CommandParameter="{x:Bind}"
                                Icon="People"
                                Text="公开此歌单" />
                            <MenuFlyoutItem
                                x:Name="ItemDelPlayList"
                                Click="ItemDelPlayList_Click"
                                CommandParameter="{x:Bind}"
                                Foreground="Red"
                                Icon="Delete"
                                Text="删除此歌单" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </ListViewItem>
        </DataTemplate>

        <DataTemplate x:Key="ToplistCardTemplate" x:DataType="home:HomeContainerCardViewModel">
            <ListViewItem
                x:Name="Card"
                Width="256"
                Height="128"
                Margin="2,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tag="{x:Bind}"
                Tapped="Card_Tapped">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind CoverUrl}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Column="1"
                        Margin="16,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Name}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Description}" />
                    </Grid>
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="MenuFlyoutItem_Click"
                                CommandParameter="{x:Bind}"
                                Icon="Play"
                                Text="播放全部" />
                            <MenuFlyoutItem
                                x:Name="ItemPublicPlayList"
                                Click="ItemPublicPlayList_Click"
                                CommandParameter="{x:Bind}"
                                Icon="People"
                                Text="公开此歌单" />
                            <MenuFlyoutItem
                                x:Name="ItemDelPlayList"
                                Click="ItemDelPlayList_Click"
                                CommandParameter="{x:Bind}"
                                Foreground="Red"
                                Icon="Delete"
                                Text="删除此歌单" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                </Grid>
            </ListViewItem>
        </DataTemplate>
        <DataTemplate x:Key="RecommendedSongCardTemplate" x:DataType="lists:SongListItemViewModel">
            <ListViewItem
                x:Name="Card"
                Width="256"
                Height="352"
                Margin="2,10"
                HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Tag="{x:Bind}"
                Tapped="Card_Tapped">
                <ui:Effects.Shadow>
                    <media:AttachedCardShadow
                        BlurRadius="0"
                        CornerRadius="0"
                        Opacity="0.4" />
                </ui:Effects.Shadow>
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="200" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <Image Source="{x:Bind CoverString}" Stretch="Uniform" />
                    </Border>
                    <Grid
                        Grid.Row="1"
                        Margin="0,4,0,4"
                        RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            MaxLines="1"
                            Text="{x:Bind SongName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind SongName}" />
                        <TextBlock
                            Grid.Row="1"
                            FontSize="14"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="1"
                            Text="{x:Bind ArtistString}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ArtistString}" />
                    </Grid>
                </Grid>
            </ListViewItem>
        </DataTemplate>
    </Page.Resources>
    <muxc:RefreshContainer RefreshRequested="RefreshRequested">
        <ScrollViewer>
            <Grid x:Name="ContentArea" Margin="0,0,0,96">
                <Grid x:Name="BackgroundLayer">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="350"
                            MinHeight="400"
                            MaxHeight="600" />
                        <RowDefinition Height="100" />
                    </Grid.RowDefinitions>
                    <controls:HomePageHeaderImage />
                </Grid>
                <Grid x:Name="ContentLayer" Margin="36,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300" />
                        <RowDefinition Height="100" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="Header">
                        <TextBlock
                            x:Name="HeaderText"
                            Margin="0,36,0,40"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Foreground="White"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            Text="主页" />
                    </Grid>
                    <Grid
                        x:Name="Toolbar"
                        Grid.Row="1"
                        HorizontalAlignment="Right">
                        <ScrollViewer>
                            <StackPanel
                                x:Name="ActionPanel"
                                Margin="0,40,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Canvas.ZIndex="1"
                                Orientation="Horizontal"
                                Spacing="12">
                                <Button
                                    Width="125"
                                    Height="60"
                                    Padding="16"
                                    Command="{x:Bind ViewModel.HeartBeatModeClickedCommand, Mode=OneWay}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontSize="22" Glyph="&#xE006;" />
                                        <TextBlock
                                            x:Uid="HomePage_Btn_MyLike"
                                            FontSize="14"
                                            Text="心动模式" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="125"
                                    Height="60"
                                    Padding="16"
                                    Command="{x:Bind ViewModel.LikedClickedCommand, Mode=OneWay}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontSize="22" Glyph="&#xE163;" />
                                        <TextBlock
                                            x:Uid="HomePage_Btn_DailyRcmd"
                                            FontSize="14"
                                            Text="每日推荐" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Width="125"
                                    Height="60"
                                    Padding="16"
                                    Command="{x:Bind ViewModel.PersonalFmClickedCommand, Mode=OneWay}"
                                    CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <FontIcon FontSize="22" Glyph="&#xEFA9;" />
                                        <TextBlock
                                            x:Uid="HomePage_Btn_PersonalFm"
                                            FontSize="14"
                                            Text="私人电台" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <Grid Grid.Row="2" Margin="12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid x:Name="SignInedDataArea">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="305" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="8,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Margin="0,4"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEB50;" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="官方歌单" />
                                    </StackPanel>
                                    <ListView
                                        Grid.Row="1"
                                        ItemTemplate="{StaticResource ToplistCardTemplate}"
                                        ItemsSource="{x:Bind ViewModel.OfficialPlaylists, Mode=OneWay}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                        ScrollViewer.HorizontalScrollMode="Enabled">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Grid>
                                <Grid Grid.Row="1" Margin="8,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel
                                        Margin="0,4"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71D;" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="推荐歌单" />
                                    </StackPanel>
                                    <ListView
                                        Grid.Row="1"
                                        ItemTemplate="{StaticResource ToplistCardTemplate}"
                                        ItemsSource="{x:Bind ViewModel.RecommendedPlaylist, Mode=OneWay}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                        ScrollViewer.HorizontalScrollMode="Enabled">
                                        <ListView.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListView.ItemsPanel>
                                    </ListView>
                                </Grid>
                            </Grid>

                            <Grid
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="8,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="12,0">
                                    <StackPanel
                                        HorizontalAlignment="Left"
                                        Orientation="Horizontal"
                                        Spacing="12">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEC4F;" />
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Style="{ThemeResource SubtitleTextBlockStyle}"
                                            Text="推荐单曲" />
                                    </StackPanel>
                                    <Button
                                        x:Name="PlayAllButton"
                                        Margin="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Command="{x:Bind ViewModel.PlayAllRecommendedSongsClickedCommand}"
                                        CommandParameter="{x:Bind ViewModel.RecommendedSongItems}"
                                        CornerRadius="14"
                                        Style="{ThemeResource AccentButtonStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="10"
                                                Glyph="&#xF5B0;" />
                                            <TextBlock
                                                x:Uid="HomePage_Btn_PlayAll"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="全部播放" />
                                        </StackPanel>
                                    </Button>
                                </Grid>


                                <StackPanel Grid.Row="1">
                                    <FlipView
                                        x:Name="RecommendedSongsFlipView"
                                        Height="380"
                                        Background="Transparent"
                                        ItemTemplate="{StaticResource RecommendedSongCardTemplate}"
                                        ItemsSource="{x:Bind ViewModel.RecommendedSongItems, Mode=OneWay}" />
                                    <muxc:PipsPager
                                        HorizontalAlignment="Center"
                                        NumberOfPages="{x:Bind ViewModel.RecommendedSongItems.Count, Mode=OneWay}"
                                        SelectedPageIndex="{x:Bind RecommendedSongsFlipView.SelectedIndex, Mode=OneWay}" />

                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="2" Margin="8,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                Margin="0,4"
                                Orientation="Horizontal"
                                Spacing="12">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE734;" />
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Style="{ThemeResource SubtitleTextBlockStyle}"
                                    Text="排行榜" />
                            </StackPanel>
                            <ListView
                                Grid.Row="1"
                                ItemTemplate="{StaticResource ToplistCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.ToplistPlaylist, Mode=OneWay}"
                                ScrollViewer.HorizontalScrollBarVisibility="Visible"
                                ScrollViewer.HorizontalScrollMode="Enabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </muxc:RefreshContainer>
</Page>
