<Page
    x:Class="HyPlayer.Features.Radio.PodcastEpisodesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls1="using:HyPlayer.UI.Lists"
    NavigationCacheMode="Disabled">
    <Grid>
        <controls1:ContainerItemsView
            x:Name="SongContainer"
            Container="{x:Bind EpisodesContainer, Mode=OneWay}"
            IsSearchEnabled="True">
            <controls1:ContainerItemsView.ListHeader>
                <StackPanel Margin="24,24,24,12" Spacing="10">
                    <TextBlock
                        x:Name="TitleText"
                        FontSize="36"
                        FontWeight="Medium"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="PlayAllButton"
                            Click="PlayAll_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE768;" />
                                <TextBlock Text="播放全部" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </controls1:ContainerItemsView.ListHeader>
        </controls1:ContainerItemsView>
    </Grid>
</Page>
