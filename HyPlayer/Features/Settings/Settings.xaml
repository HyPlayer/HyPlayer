                                                x:Name="AutoHidePlayBarTime"
                                                Width="256"
                                                HorizontalAlignment="Right"
                                                Maximum="10"
                                                Minimum="1"
                                                ToolTipService.ToolTip="{x:Bind AutoHidePlayBarTime.Value}"
                                                Value="{x:Bind UI.AutoHidePlaybarTime, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="启用磁贴">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind UI.EnableTile, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="启用磁贴背景" Visibility="{x:Bind UI.EnableTile, Mode=OneWay}">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind UI.EnableTileBackground, Mode=TwoWay}" />
