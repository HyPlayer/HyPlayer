                                                    <RepositionThemeTransition />
                                                </TransitionCollection>
                                            </HyperlinkButton.Transitions>
                                        </HyperlinkButton>
                                    </controls3:SettingsCard.Header>
                                </controls3:SettingsCard>


                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </PivotItem>
