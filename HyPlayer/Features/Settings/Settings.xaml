<Page
    x:Class="HyPlayer.Features.Settings.Settings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:controls2="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:controls3="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hyplayer="using:HyPlayer.Platform.Xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uiControls="using:HyPlayer.UI.Controls"
    FontFamily="{ThemeResource ContentControlThemeFontFamily}"
    FontSize="14"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>
        <Thickness x:Key="PivotItemMargin">0</Thickness>

    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ContentDialog
            x:Name="AboutRomajiDialog"
            Title="关于此选项"
            CloseButtonStyle="{StaticResource AccentButtonStyle}"
            CloseButtonText="好的">
            <RichTextBlock>
                <Paragraph>
                    HyPlayer支持使用:<LineBreak />
                    &#x27A4; 网易云音乐: 网易云音乐提供的罗马字歌词<LineBreak />
                    &#x27A4; Kawazu: 内置罗马字转换器 (需下载资源包)<LineBreak />
                    &#x27A4; 自动选择：优先使用网易云音乐提供的罗马字<LineBreak />
                    如当前歌词网易云音乐没有提供罗马字，则使用 Kawazu 进行转换</Paragraph>
            </RichTextBlock>
        </ContentDialog>

        <TextBlock
            Grid.Row="0"
            Margin="16,16,24,8"
            VerticalAlignment="Center"
            CharacterSpacing="0"
            FontSize="28"
            FontWeight="SemiBold"
            Text="设置" />
        <uiControls:PivotView Grid.Row="1">
            <uiControls:PivotEx>
                <PivotItem Header="歌词设置">
                    <Grid>
                        <ScrollViewer Margin="0,48,0,0" VerticalScrollMode="Enabled">
                            <StackPanel
                                x:Name="StackPanelLyricSet"
                                Margin="12,8,12,0"
                                Padding="0,0,0,144"
                                HorizontalAlignment="Stretch"
                                Orientation="Vertical"
                                Spacing="12">
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="罗马字设置"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8C1;" />
                                    </controls3:SettingsExpander.HeaderIcon>

                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>

                                        <controls3:SettingsCard x:Name="RomajiStatus" Header="获取中...">

                                            <Button
                                                x:Name="ButtonDownloadRomaji"
                                                HorizontalAlignment="Right"
                                                Click="ButtonBase_OnClick"
                                                Content="获取罗马字资源文件" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="切歌后生效" Header="罗马字源">
                                            <ComboBox
                                                x:Name="RomajiSource"
                                                HorizontalAlignment="Right"
                                                SelectedIndex="{x:Bind Lyric.LyricRomajiSource, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="不转换" />
                                                <ComboBoxItem Content="自动选择" />
                                                <ComboBoxItem Content="网易云音乐" />
                                                <ComboBoxItem Content="Kawazu" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard>
                                            <HyperlinkButton
                                                x:Name="AboutRomaji"
                                                Click="AboutRomaji_Click"
                                                Content="关于此选项" />
                                        </controls3:SettingsCard>

                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>

                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="歌词大小"
                                    HeaderIcon="FontSize"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Description="0为自动" Header="歌词大小">
                                            <controls:NumberBox
                                                x:Name="LyricSize"
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind UI.LyricSize, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="0为自动" Header="翻译大小">
                                            <controls:NumberBox
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind Lyric.TranslationSize, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="0为自动" Header="罗马字大小">
                                            <controls:NumberBox
                                                x:Name="RomajiSize"
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind Lyric.RomajiSize, Mode=TwoWay}" />
                                        </controls3:SettingsCard>

                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>

                                <!--<CheckBox
                                x:Name="CheckBoxLyricShadow"
                                Content="开启歌词阴影"
                                IsChecked="{x:Bind Lyric.LyricDropShadow, Mode=TwoWay}" />-->
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="歌词显示"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE18F;" />
                                    </controls3:SettingsExpander.HeaderIcon>
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>

                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Header="使用 AMLL TTML Database">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.EnableAmllTtmlDb, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard
                                            Description=" [NCM_ID] 为网易云音乐 ID 占位符"
                                            Header="AMLL TTML 镜像地址"
                                            Visibility="{x:Bind Lyric.EnableAmllTtmlDb, Mode=OneWay}">
                                            <TextBox HorizontalAlignment="Left" Text="{x:Bind Lyric.AmllTtmlMirrorUrl, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="歌词主色调">
                                            <ComboBox HorizontalAlignment="Right" SelectedIndex="{x:Bind UI.LyricColor, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="自动" />
                                                <ComboBoxItem Content="白色" />
                                                <ComboBoxItem Content="黑色" />
                                                <ComboBoxItem Content="唱片主色调" />
                                            </ComboBox>
                                        </controls3:SettingsCard>

                                        <controls3:SettingsCard Description="重置即为歌词主色调" Header="显示颜色自定义选项">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind IsAdvancedLyricColorSettingsShow, Mode=TwoWay}" />
                                        </controls3:SettingsCard>

                                        <controls3:SettingsCard Header="非焦点歌词颜色 (普通歌词)" Visibility="{x:Bind IsAdvancedLyricColorSettingsShow, Mode=OneWay}">
                                            <Grid MinWidth="10" HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls3:ColorPickerButton
                                                    x:Name="PureLyricIdle"
                                                    Grid.Column="0"
                                                    SelectedColor="{x:Bind Lyric.PureLyricIdleColor, Mode=OneWay, Converter={StaticResource NullableColorToColorConverter}}">
                                                    <controls3:ColorPickerButton.ColorPickerStyle>
                                                        <Style TargetType="controls:ColorPicker">
                                                            <Setter Property="ColorSpectrumShape" Value="Box" />
                                                            <Setter Property="IsAlphaEnabled" Value="True" />
                                                            <Setter Property="IsHexInputVisible" Value="False" />
                                                        </Style>
                                                    </controls3:ColorPickerButton.ColorPickerStyle>
                                                </controls3:ColorPickerButton>
                                                <Button Grid.Column="1" Click="ConfirmPureLyricIdleColor">确认</Button>
                                                <Button Grid.Column="2" Click="ResetPureLyricIdleColor">重置</Button>
                                            </Grid>

                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="焦点歌词颜色 (普通歌词)" Visibility="{x:Bind IsAdvancedLyricColorSettingsShow, Mode=OneWay}">
                                            <Grid MinWidth="10" HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls3:ColorPickerButton
                                                    x:Name="PureLyricFocusing"
                                                    Grid.Column="0"
                                                    SelectedColor="{x:Bind Lyric.PureLyricFocusingColor, Mode=OneWay, Converter={StaticResource NullableColorToColorConverter}}">
                                                    <controls3:ColorPickerButton.ColorPickerStyle>
                                                        <Style TargetType="controls:ColorPicker">
                                                            <Setter Property="ColorSpectrumShape" Value="Box" />
                                                            <Setter Property="IsAlphaEnabled" Value="True" />
                                                            <Setter Property="IsHexInputVisible" Value="False" />
                                                        </Style>
                                                    </controls3:ColorPickerButton.ColorPickerStyle>
                                                </controls3:ColorPickerButton>
                                                <Button Grid.Column="1" Click="ConfirmPureLyricFocusingColor">确认</Button>
                                                <Button Grid.Column="2" Click="ResetPureLyricFocusingColor">重置</Button>
                                            </Grid>

                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="焦点歌词颜色 (逐字歌词)" Visibility="{x:Bind IsAdvancedLyricColorSettingsShow, Mode=OneWay}">
                                            <Grid MinWidth="10" HorizontalAlignment="Right">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls3:ColorPickerButton
                                                    x:Name="KaraokLyricFocusing"
                                                    Grid.Column="0"
                                                    SelectedColor="{x:Bind Lyric.KaraokeLyricFocusingColor, Mode=OneWay, Converter={StaticResource NullableColorToColorConverter}}">
                                                    <controls3:ColorPickerButton.ColorPickerStyle>
                                                        <Style TargetType="controls:ColorPicker">
                                                            <Setter Property="ColorSpectrumShape" Value="Box" />
                                                            <Setter Property="IsAlphaEnabled" Value="True" />
                                                            <Setter Property="IsHexInputVisible" Value="False" />
                                                        </Style>
                                                    </controls3:ColorPickerButton.ColorPickerStyle>
                                                </controls3:ColorPickerButton>
                                                <Button Grid.Column="1" Click="ConfirmKaraokLyricFocusingColor">确认</Button>
                                                <Button Grid.Column="2" Click="ResetKaraokLyricFocusingColor">重置</Button>
                                            </Grid>
                                        </controls3:SettingsCard>

                                        <controls3:SettingsCard Header="对齐方式">
                                            <ComboBox
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                SelectedIndex="{x:Bind UI.LyricAlignment, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="左对齐" />
                                                <ComboBoxItem Content="居中" />
                                                <ComboBoxItem Content="右对齐" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="歌词字体">
                                            <ComboBox
                                                x:Name="FontBox"
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                DisplayMemberPath="Name"
                                                SelectedValue="{x:Bind Lyric.LyricFontFamily, Mode=TwoWay}"
                                                SelectedValuePath="Value" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="单位 %" Header="歌词距离顶部百分比">
                                            <controls:NumberBox
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                Maximum="100"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind Lyric.LyricPaddingTopRatio, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="单位 %" Header="歌词宽度占容器百分比">
                                            <controls:NumberBox
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                Maximum="100"
                                                Minimum="0"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind Lyric.LyricRenderWidthRatio, Mode=TwoWay}" />
                                        </controls3:SettingsCard>

                                        <controls3:SettingsCard Header="歌词行间距">
                                            <controls:NumberBox
                                                MinWidth="100"
                                                HorizontalAlignment="Right"
                                                LargeChange="5"
                                                SmallChange="1"
                                                SpinButtonPlacementMode="Compact"
                                                Value="{x:Bind Lyric.LyricLineSpacing, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="开启时启动热词">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.HotLyricOnStartup, Mode=TwoWay}"
                                                Toggled="HotLyricOnStartUp_Checked" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="显示作词作曲信息">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.ShowComposerInLyric, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="自动合并歌词">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.MigrateLyrics, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="将会优化歌词时间轴效果, 可能会改变原本时间轴" Header="优化歌词时间轴">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.OptimizeLyric, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="歌词特效"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE794;" />
                                    </controls3:SettingsExpander.HeaderIcon>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Description="拖动排序、编辑表达式与绘图脚本，支持 .hylfx 导入导出" Header="歌词特效链">
                                            <Button
                                                HorizontalAlignment="Right"
                                                Click="OpenLyricEffectSettings_Click"
                                                Content="编辑特效链" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="音译扫词">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.LyricRenderTransliterationScanning, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="非逐字行扫词">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.LyricRenderSimpleLineScanning, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="扫词样式">
                                            <ComboBox HorizontalAlignment="Right" SelectedIndex="{x:Bind Lyric.LyricRenderScanStyle, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="矩形显露" />
                                                <ComboBoxItem Content="逐字透明度" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Description="将会把每一行歌词预渲染, 将会造成大量内存占用" Header="预渲染合成">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Lyric.LyricCacheRenderTarget, Mode=TwoWay}" />
                                        </controls3:SettingsCard>

                                        <controls3:SettingsCard Description="不同函数有不同的效果" Header="行滚动函数">
                                            <ComboBox HorizontalAlignment="Right" SelectedIndex="{x:Bind Lyric.LineRollingCalculator, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
                                                <ComboBoxItem Content="弹簧函数" />
                                                <ComboBoxItem Content="三角函数" />
                                                <ComboBoxItem Content="Lyricify 函数" />
                                                <ComboBoxItem Content="同步线性函数" />
                                                <ComboBoxItem Content="CircleEase" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>

                                </controls3:SettingsExpander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </PivotItem>
                <PivotItem Header="播放设置">
                    <Grid>
                        <ScrollViewer Margin="0,48,0,0" VerticalScrollMode="Enabled">
                            <StackPanel
                                Margin="12,8,12,0"
                                Padding="0,0,0,144"
                                Orientation="Vertical"
                                Spacing="12">
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="音质设置"
                                    HeaderIcon="MusicInfo"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Header="在线播放音质">
                                            <ComboBox
                                                x:Name="ComboBoxSongBr"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="ComboBoxSongBr_SelectionChanged">
                                                <ComboBoxItem Content="标准 (128k)" Tag="standard" />
                                                <ComboBoxItem Content="较高 (???k)" Tag="higher" />
                                                <ComboBoxItem Content="极高 (320k)" Tag="exhigh" />
                                                <ComboBoxItem Content="无损 (VIP)" Tag="lossless" />
                                                <ComboBoxItem Content="Hi-Res (VIP)" Tag="hires" />
                                                <ComboBoxItem Content="高清环绕声 (Spatial Audio)" Tag="jyeffect" />
                                                <ComboBoxItem Content="沉浸环绕声 (Surround Audio)" Tag="sky" />
                                                <ComboBoxItem Content="超清母带 (Master)" Tag="jymaster" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="歌曲下载音质">
                                            <ComboBox
                                                x:Name="ComboBoxSongDownloadBr"
                                                Grid.Row="1"
                                                HorizontalAlignment="Right"
                                                SelectionChanged="ComboBoxSongDownloadBr_SelectionChanged">
                                                <ComboBoxItem Content="标准 (128k)" Tag="standard" />
                                                <ComboBoxItem Content="较高 (???k)" Tag="higher" />
                                                <ComboBoxItem Content="极高 (320k)" Tag="exhigh" />
                                                <ComboBoxItem Content="无损 (VIP)" Tag="lossless" />
                                                <ComboBoxItem Content="Hi-Res (VIP)" Tag="hires" />
                                                <ComboBoxItem Content="高清环绕声 (Spatial Audio)" Tag="jyeffect" />
                                                <ComboBoxItem Content="沉浸环绕声 (Surround Audio)" Tag="sky" />
                                                <ComboBoxItem Content="超清母带 (Master)" Tag="jymaster" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>

                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="渐入渐出"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE799;" />
                                    </controls3:SettingsExpander.HeaderIcon>
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Header="曲目过渡">
                                            <ComboBox
                                                x:Name="TransitionMode"
                                                MinWidth="180"
                                                HorizontalAlignment="Right"
                                                SelectedValue="{x:Bind Playback.TransitionId, Mode=OneWay}"
                                                SelectedValuePath="Tag"
                                                SelectionChanged="TransitionMode_SelectionChanged">
                                                <ComboBoxItem Content="直接切换" Tag="dir" />
                                                <ComboBoxItem Content="提前准备" Tag="gap" />
                                                <ComboBoxItem Content="交叉淡化" Tag="xfd" />
                                            </ComboBox>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="交叉淡化渐入渐出时间 单位: s" Visibility="{x:Bind Playback.IsCrossFadeTransition, Mode=OneWay}">
                                            <Slider
                                                x:Name="CrossFadeTime"
                                                Width="256"
                                                HorizontalAlignment="Right"
                                                IsEnabled="{x:Bind Playback.IsCrossFadeTransition, Mode=OneWay}"
                                                Maximum="10"
                                                Minimum="3"
                                                StepFrequency="1"
                                                TickFrequency="1"
                                                ToolTipService.ToolTip="{x:Bind CrossFadeTime.Value, Mode=OneWay}"
                                                Value="{x:Bind Playback.CrossFadeTime, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>

                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="随机设置"
                                    HeaderIcon="RepeatAll"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Header="显示随机列表">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind UI.DisplayShuffledList, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="输出设置"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7F6;" />
                                    </controls3:SettingsExpander.HeaderIcon>
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
                                        <controls3:SettingsCard Header="选择音频输出设备">
                                            <Button
                                                x:Name="BtnChangeAudioRenderDevice"
                                                HorizontalAlignment="Right"
                                                Click="BtnChangeAudioRenderDevice_Click"
                                                Content="选择" />
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard>
                                            <controls3:SettingsCard.Header>
                                                <HyperlinkButton
                                                    x:Name="BtnChangeToDefaultAudioRenderDevice"
                                                    Click="BtnChangeToDefaultAudioRenderDevice_Click"
                                                    Content="恢复默认" />

                                            </controls3:SettingsCard.Header>
                                        </controls3:SettingsCard>
                                        <controls3:SettingsCard Header="启用音量平衡">
                                            <ToggleSwitch
                                                MinWidth="10"
                                                HorizontalAlignment="Right"
                                                IsOn="{x:Bind Playback.EnableAudioGain, Mode=TwoWay}" />
                                        </controls3:SettingsCard>
                                    </controls3:SettingsExpander.Items>
                                </controls3:SettingsExpander>
                                <controls3:SettingsExpander
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Header="跳过 VIP 试听歌曲"
                                    HeaderIcon="Forward"
                                    IsExpanded="True">
                                    <controls3:SettingsExpander.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </controls3:SettingsExpander.Transitions>
                                    <controls3:SettingsExpander.Items>
