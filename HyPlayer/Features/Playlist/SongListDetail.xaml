<Page
    x:Class="HyPlayer.Features.Playlist.SongListDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls1="using:HyPlayer.UI.Lists"
    xmlns:uiControls="using:HyPlayer.UI.Controls"
    xmlns:controls2="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:frieren="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:media="using:CommunityToolkit.WinUI.Media"
    xmlns:pages="using:HyPlayer.Features.Playlist"
    xmlns:ui="using:CommunityToolkit.WinUI"
    x:Name="Page"
    d:DataContext="{d:DesignInstance Type=pages:SongListDetail}"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <AcrylicBrush
                        x:Key="SongListPageAcrylicBrush"
                        BackgroundSource="Backdrop"
                        FallbackColor="{ThemeResource SystemRevealAltMediumHighColor}"
                        TintColor="{ThemeResource SystemRevealAltHighColor}"
                        TintLuminosityOpacity="0.5"
                        TintOpacity="0.5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="175" />
        </Grid.RowDefinitions>
        <controls2:ProgressRing
            Grid.Row="0"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="True"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <controls1:SongsList
            x:Name="SongsList"
            Grid.RowSpan="2"
            CanViewComments="True"
            IsMySongList="{x:Bind ViewModel.IsMySongList, Mode=OneWay}"
            IsSearchEnabled="True"
            QueueScope="{x:Bind ViewModel.QueueScope, Mode=OneWay}"
            Songs="{x:Bind ViewModel.Songs, Mode=OneWay}">
            <controls1:SongsList.ListHeader>
                <Grid>
                    <Border
                        x:Name="RectangleImageBack"
                        Grid.Column="0"
                        Grid.ColumnSpan="2">
                        <Border.Background>
                            <LinearGradientBrush Opacity="0.5" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="AlbumColor" Offset="0" Color="{x:Bind ViewModel.AlbumColor, Mode=OneWay}" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Grid Padding="32" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <frieren:ImageEx
                            x:Name="RectangleImage"
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Left"
                            CornerRadius="8"
                            Source="{x:Bind ViewModel.CoverUri, Mode=OneWay}">
                            <ui:Effects.Shadow>
                                <media:AttachedCardShadow
                                    CornerRadius="8"
                                    Opacity="0.3"
                                    Offset="0,4,1"
                                    Color="Black" />
                            </ui:Effects.Shadow>
                        </frieren:ImageEx>
                        <StackPanel
                            Grid.Column="1"
                            Margin="0,0,0,12"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TextBoxPLName"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.PlayList.Name, Mode=OneWay}" />
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="4">
                                <HyperlinkButton
                                    x:Name="TextBoxAuthor"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.NavigateToAuthorCommand}"
                                    Content="{x:Bind ViewModel.PlayList.Creator.Name, Mode=OneWay}"
                                    FontSize="16"
                                    Style="{StaticResource TextBlockButtonStyle}" />
                                <TextBlock
                                    x:Name="TextBoxUpdateTime"
                                    Margin="0,2,0,0"
                                    FontSize="16"
                                    Text="{x:Bind ViewModel.UpdateTime, Mode=OneWay}" />

                            </StackPanel>
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    x:Name="ButtonLike"
                                    Margin="0,6,0,0"
                                    Command="{x:Bind ViewModel.LikePlaylistCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon
                                            x:Name="LikedIcon"
                                            Margin="0,0,8,0"
                                            FontSize="12"
                                            Glyph="{x:Bind ViewModel.PlayList.HasSubscribed, Mode=OneWay, Converter={StaticResource BoolToLikeIconConverter}}" />
                                        <TextBlock x:Name="LikeBtnText" Text="{x:Bind ViewModel.PlayList.HasSubscribed, Mode=OneWay, Converter={StaticResource BoolToLikeStringConverter}}" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="0,6,0,0" Command="{x:Bind ViewModel.PlayAllCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <FontIcon
                                            x:Name="IconPlay"
                                            FontSize="12"
                                            Glyph="&#xF5B0;" />
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Text="播放"
                                            ToolTipService.ToolTip="播放全部" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="ButtonIntel"
                                    Margin="0,6,0,0"
                                    Command="{x:Bind ViewModel.EnterIntelligencePlayCommand}"
                                    Visibility="{x:Bind ViewModel.IntelligenceModeVisible, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <!--  ReSharper disable once Xaml.InvalidResourceType  -->
                                        <FontIcon
                                            x:Name="IconLiked"
                                            FontSize="14"
                                            Foreground="{ThemeResource SystemBaseHighColor}"
                                            Glyph="&#xE00B;" />
                                        <!--  ReSharper disable once Xaml.InvalidResourceType  -->
                                        <TextBlock
                                            Margin="8,0,0,0"
                                            Foreground="{ThemeResource SystemBaseHighColor}"
                                            Text="心动模式" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <Button
                                x:Name="ButtonMore"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTipService.ToolTip="更多选项">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.PlayAllCommand}"
                                            Icon="Add"
                                            Text="添加" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.DownloadAllCommand}"
                                            Icon="Download"
                                            Text="下载" />
                                        <MenuFlyoutItem
                                            Click="BtnShare_Clicked"
                                            Icon="Share"
                                            Text="分享" />
                                        <MenuFlyoutItem
                                            Command="{x:Bind ViewModel.ResetCacheCommand}"
                                            Icon="Refresh"
                                            Text="刷新缓存" />

                                    </MenuFlyout>
                                </Button.Flyout>
                                <FontIcon Glyph="&#xE10C;" />
                            </Button>

                        </StackPanel>
                        <uiControls:ExpandableTextBox
                            x:Name="DescriptionTextBlock"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,12,0,35"
                            FontSize="16"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            MaxLines="4"
                            Text="{x:Bind ViewModel.DescriptionBoxContent, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </controls1:SongsList.ListHeader>
            <controls1:SongsList.Footer>
                <Button
                    x:Name="NextPage"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Content="加载更多"
                    Style="{StaticResource ButtonRevealStyle}"
                    Visibility="{x:Bind ViewModel.HasMore}" />
            </controls1:SongsList.Footer>
        </controls1:SongsList>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StackPanelUserInfo.(Grid.Column)" Value="1" />
                        <Setter Target="Btns.Margin" Value="0,20,5,10" />
                        <Setter Target="StackPanelUserInfo.(Grid.ColumnSpan)" Value="10" />
                        <Setter Target="Btns.VerticalAlignment" Value="Bottom" />
                        <Setter Target="Btns.Spacing" Value="5" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState>
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1300" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RectangleImage.Visibility" Value="Visible" />
                        <Setter Target="StackPanelUserInfo.(Grid.Column)" Value="5" />
                        <Setter Target="StackPanelUserInfo.(Grid.ColumnSpan)" Value="6" />
                        <Setter Target="Btns.VerticalAlignment" Value="Top" />
                        <Setter Target="Btns.Margin" Value="0,20,10,10" />
                        <Setter Target="Btns.Spacing" Value="10" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>


</Page>
