<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<Platforms>ARM64;x64</Platforms>
		<Configurations>Debug;Release</Configurations>
		<WindowsSdkPackageVersion>10.0.26100.87</WindowsSdkPackageVersion>
		<RuntimeIdentifiers>win10-x64;win10-arm64</RuntimeIdentifiers>
		<UseRidGraph>true</UseRidGraph>
		<UseUwp>true</UseUwp>

	</PropertyGroup>

	<PropertyGroup>
		<CsWinRTIncludes>Microsoft.Gaming.XboxGameBar</CsWinRTIncludes>
		<DefaultLanguage>zh-CN</DefaultLanguage>
	</PropertyGroup>

	<ItemGroup>
		<CsWinRTInputs Include="$(PkgMicrosoft_Gaming_XboxGameBar)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd" />
		<CsWinRTInputs Include="$(PkgMicrosoft_Gaming_XboxGameBar)\private\Microsoft.Gaming.XboxGameBar.Private.winmd" />
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Microsoft.Gaming.XboxGameBar" Version="7.3.2607010" GeneratePathProperty="true">
			<ExcludeAssets>compile;runtime</ExcludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PkgMicrosoft_Gaming_XboxGameBar)\runtimes\win10-$(Platform)\native\Microsoft.Gaming.XboxGameBar.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="$(PkgMicrosoft_Gaming_XboxGameBar)\lib\uap10.0\Microsoft.Gaming.XboxGameBar.winmd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Implementation>Microsoft.Gaming.XboxGameBar.dll</Implementation>
		</None>
		<None Include="$(PkgMicrosoft_Gaming_XboxGameBar)\private\Microsoft.Gaming.XboxGameBar.Private.winmd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<SkipHarvestingWinmdRegistration>true</SkipHarvestingWinmdRegistration>
		</None>
		<Content Include="$(PkgMicrosoft_Gaming_XboxGameBar)\runtimes\win10-$(Platform)\native\Microsoft.Gaming.XboxGameBar.pri" />
	</ItemGroup>
	
</Project>
